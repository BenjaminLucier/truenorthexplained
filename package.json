    "csv-parse": "^7.0.3",
    "d3-geo": "^3.1.2",
    "fflate": "^0.8.3",
    "lucide-static": "^1.72.0",
    "mapshaper": "^0.7.101",
    "mermaid-isomorphic": "^3.1.0",
    "pagefind": "^1.6.0",
    "playwright": "^1.65.0",
    "satteri": "0.11.7",
    "tailwindcss": "^4.3.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-beta",
    "yaml": "^2.9.1"
  }
