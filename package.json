{
  "name": "truenorthexplained",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro sync && tsc --noEmit --runExternalCode",
    "validate": "tsx scripts/validate.ts",
    "review": "tsx scripts/validate.ts --review",
    "data:elections": "tsx scripts/data/elections.ts",
    "data:election-history": "tsx scripts/data/election-history.ts",
    "data:premiers": "tsx scripts/data/premiers.ts",
    "data:geo": "tsx scripts/data/geo.ts",
    "data:money": "tsx scripts/data/money.ts",
    "data:population": "tsx scripts/data/province-population.ts",
    "data:treaties": "tsx scripts/data/treaties.ts",
    "data:demographics": "tsx scripts/data/demographics.ts",
    "data:portraits": "tsx scripts/data/portraits.ts",
    "grounding": "tsx scripts/grounding/index.ts",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "freshness": "tsx scripts/freshness.ts",
    "refresh": "tsx scripts/refresh.ts",
    "sources": "tsx scripts/sources.ts"
  },
  "dependencies": {
    "astro": "7.4.13"
  },
  "devDependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/topojson-client": "^3.1.5",
    "csv-parse": "^7.0.3",
    "d3-geo": "^3.1.2",
    "fflate": "^0.8.3",
    "lucide-static": "^1.75.0",
    "mapshaper": "^0.8.5",
    "mermaid-isomorphic": "^3.1.0",
    "pagefind": "^1.6.0",
    "playwright": "^1.65.1",
    "satteri": "0.11.7",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.5",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-dev.20261120.1",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
