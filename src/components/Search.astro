---
/**
 * Site search: a native <dialog> driven by Pagefind's JS API.
 *
 * The index is built after `astro build` by `pagefind --site dist` (see the
 * build script) from content marked `data-pagefind-body`. The API is loaded
 * with a dynamic import the first time the dialog opens. In `pnpm dev` there's
 * no index, so the dialog says how to try it instead.
 *
 * Any element with `data-search-open` opens the dialog (the header button and
 * the mobile menu item). Shortcuts: "/" and Cmd/Ctrl+K.
 */
import Icon from "./Icon.astro";
---

<site-search data-dev={import.meta.env.DEV ? "" : undefined}>
  <dialog class="search-dialog" aria-labelledby="search-title">
    <h2 id="search-title" class="sr-only">Search the site</h2>
    <form method="dialog" role="search" class="flex items-center gap-3 border-b border-subtle px-4">
      <Icon name="Search" class="size-5 text-muted" />
      <label for="search-input" class="sr-only">Search</label>
      <input
        id="search-input"
        type="text"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-results"
        aria-autocomplete="list"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        placeholder="Search the Crown, the Senate, treaties…"
        class="h-14 min-w-0 flex-1 bg-transparent text-base text-primary placeholder:text-muted focus:outline-none"
      />
      <button
        type="button"
        data-close
        class="rounded-md border border-subtle px-1.5 py-0.5 text-xs font-medium text-muted hover:border-strong hover:text-primary"
      >
        <span aria-hidden="true">Esc</span>
        <span class="sr-only">Close search</span>
      </button>
    </form>

    <div class="search-body overflow-y-auto overscroll-contain">
      <p data-status role="status" class="px-4 py-3 text-sm text-muted empty:hidden"></p>
      <ul id="search-results" role="listbox" aria-label="Results" class="px-2 pb-2"></ul>
    </div>

    <div class="hidden items-center gap-4 border-t border-subtle px-4 py-2.5 text-xs text-muted sm:flex">
      <span class="inline-flex items-center gap-1.5"><kbd>↑</kbd><kbd>↓</kbd> to move</span>
      <span class="inline-flex items-center gap-1.5"><kbd>↵</kbd> to open</span>
      <span class="inline-flex items-center gap-1.5"><kbd>Esc</kbd> to close</span>
    </div>
  </dialog>

  <template data-result>
    <li role="option" aria-selected="false" class="search-option">
      <a tabindex="-1" class="block rounded-lg px-3 py-2.5">
        <span data-section class="block text-xs font-medium text-muted empty:hidden"></span>
        <span data-title class="block font-semibold text-primary"></span>
        <span data-excerpt class="search-excerpt mt-0.5 block text-sm text-secondary"></span>
      </a>
    </li>
  </template>
</site-search>

<style>
  .search-dialog {
    width: min(42rem, calc(100vw - 1.5rem));
    max-width: none;
    max-height: min(36rem, calc(100dvh - 6rem));
    margin: 4.5rem auto auto;
    padding: 0;
    border: 1px solid var(--tn-border);
    border-radius: 1rem;
    background: var(--tn-surface);
    color: var(--tn-text-primary);
    box-shadow:
      0 2px 6px rgb(0 0 0 / 0.08),
      0 24px 64px rgb(0 0 0 / 0.2);
    overflow: hidden;
  }
  .search-dialog[open] {
    display: flex;
    flex-direction: column;
  }
  .search-dialog::backdrop {
    background: rgb(12 14 16 / 0.45);
  }
  @media (min-width: 40rem) {
    .search-dialog {
      margin-top: 12vh;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .search-dialog[open] {
      animation: search-in 140ms ease-out;
    }
    @keyframes search-in {
      from {
        opacity: 0;
        translate: 0 -6px;
      }
    }
  }
  .search-body {
    flex: 1;
    min-height: 0;
  }
  kbd {
    display: inline-flex;
    min-width: 1.25rem;
    justify-content: center;
    padding: 0 0.3rem;
    border: 1px solid var(--tn-border);
    border-radius: 0.3rem;
    background: var(--tn-surface-muted);
    font: inherit;
    font-size: 0.7rem;
  }
  .search-option[aria-selected="true"] > a {
    background: var(--tn-accent-soft);
  }
  .search-option[aria-selected="true"] [data-title] {
    color: var(--tn-accent);
  }
  .search-option[data-sub] > a {
    margin-inline-start: 1rem;
    padding-top: 0.375rem;
    padding-bottom: 0.375rem;
    border-inline-start: 2px solid var(--tn-border);
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .search-option[data-sub] [data-title] {
    font-weight: 500;
    font-size: 0.875rem;
  }
  .search-excerpt :global(mark) {
    background: var(--tn-accent-soft);
    color: var(--tn-text-primary);
    font-weight: 600;
    border-radius: 0.2rem;
    padding: 0 0.1rem;
  }
  .search-option[aria-selected="true"] .search-excerpt :global(mark) {
    background: var(--tn-surface);
  }
</style>

<script>
  interface PagefindSubResult {
    title: string;
    url: string;
    excerpt: string;
  }
  interface PagefindResultData {
    url: string;
    excerpt: string;
    meta: { title?: string; section?: string };
    sub_results?: PagefindSubResult[];
  }
  interface PagefindApi {
    options(opts: Record<string, unknown>): Promise<void>;
    init(): Promise<void>;
    debouncedSearch(
      term: string,
      opts?: Record<string, unknown>,
      ms?: number,
    ): Promise<{ results: { data(): Promise<PagefindResultData> }[] } | null>;
  }

  const MAX_RESULTS = 8;
  const MAX_SUB = 2;

  class SiteSearch extends HTMLElement {
    private dialog!: HTMLDialogElement;
    private input!: HTMLInputElement;
    private list!: HTMLUListElement;
    private status!: HTMLElement;
    private template!: HTMLTemplateElement;
    private pagefind: Promise<PagefindApi | undefined> | undefined;
    private active = -1;
    private opener: HTMLElement | null = null;

    connectedCallback() {
      this.dialog = this.querySelector("dialog")!;
      this.input = this.querySelector("input")!;
      this.list = this.querySelector("[role=listbox]")!;
      this.status = this.querySelector("[data-status]")!;
      this.template = this.querySelector("template[data-result]")!;

      document.addEventListener("click", (e) => {
        const trigger = (e.target as Element).closest<HTMLElement>("[data-search-open]");
        if (!trigger) return;
        e.preventDefault();
        // Opened from the mobile menu: close that first.
        trigger.closest("dialog")?.close();
        this.open(trigger);
      });
      document.addEventListener("keydown", (e) => this.onShortcut(e));
      this.querySelector("[data-close]")!.addEventListener("click", () => this.dialog.close());
      this.dialog.addEventListener("click", (e) => {
        if (e.target === this.dialog) this.dialog.close();
      });
      this.dialog.addEventListener("close", () => {
        this.opener?.focus();
        this.opener = null;
      });
      this.input.addEventListener("input", () => void this.search());
      this.input.addEventListener("keydown", (e) => this.onInputKey(e));
      this.list.addEventListener("click", (e) => {
        if (!(e.target as Element).closest("a")) return;
        // Following a result (possibly a #section on this page): don't send focus back to the opener.
        this.opener = null;
        this.dialog.close();
      });
      this.list.addEventListener("mousemove", (e) => {
        const option = (e.target as Element).closest<HTMLElement>("[role=option]");
        if (option) this.setActive(this.options().indexOf(option), false);
      });
    }

    private onShortcut(e: KeyboardEvent) {
      const isK = e.key.toLowerCase() === "k" && (e.metaKey || e.ctrlKey) && !e.altKey && !e.shiftKey;
      const target = e.target as HTMLElement;
      const typing =
        target.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName) || target.closest("[contenteditable]");
      const isSlash = e.key === "/" && !e.metaKey && !e.ctrlKey && !e.altKey && !typing;
      if (!isK && !isSlash) return;
      e.preventDefault();
      if (this.dialog.open) {
        this.input.focus();
        this.input.select();
      } else {
        this.open(document.activeElement as HTMLElement | null);
      }
    }

    private open(opener: HTMLElement | null) {
      if (this.dialog.open) return;
      this.opener = opener;
      document.querySelectorAll<HTMLDialogElement>("dialog[open]").forEach((d) => d !== this.dialog && d.close());
      this.dialog.showModal();
      this.input.focus();
      this.input.select();
      this.pagefind ??= this.load();
      if (!this.input.value) this.renderHint();
    }

    private async load(): Promise<PagefindApi | undefined> {
      try {
        // Built by `pagefind --site dist`; not processed by Vite.
        const url = "/pagefind/pagefind.js";
        const api = (await import(/* @vite-ignore */ url)) as PagefindApi;
        await api.options({ excerptLength: 22 });
        void api.init();
        return api;
      } catch {
        return undefined;
      }
    }

    private renderHint() {
      this.list.replaceChildren();
      this.setExpanded(false);
      this.status.textContent = "Type a word or two, like “senate”, “treaty” or “notwithstanding”.";
    }

    private async search() {
      const term = this.input.value.trim();
      if (!term) return this.renderHint();
      const api = await this.pagefind;
      if (!api) {
        this.list.replaceChildren();
        this.setExpanded(false);
        this.status.textContent =
          this.dataset.dev !== undefined
            ? "Search runs on the built site. Run “pnpm build”, then “pnpm preview”, to try it. (The dev server has no search index.)"
            : "Search couldn't load. Check your connection and try again.";
        return;
      }
      const found = await api.debouncedSearch(term, {}, 150);
      if (!found || term !== this.input.value.trim()) return; // superseded by newer typing
      const data = await Promise.all(found.results.slice(0, MAX_RESULTS).map((r) => r.data()));
      if (term !== this.input.value.trim()) return;
      this.render(term, data, found.results.length);
    }

    private render(term: string, results: PagefindResultData[], total: number) {
      const items: HTMLLIElement[] = [];
      results.forEach((r, i) => {
        items.push(this.option(`search-r${i}`, r.url, r.meta.title ?? r.url, r.excerpt, r.meta.section));
        const subs = (r.sub_results ?? []).filter((s) => s.url !== r.url && s.url.includes("#")).slice(0, MAX_SUB);
        subs.forEach((s, j) => items.push(this.option(`search-r${i}-${j}`, s.url, s.title, s.excerpt, undefined, true)));
      });
      this.list.replaceChildren(...items);
      this.setExpanded(items.length > 0);
      this.status.textContent =
        total === 0
          ? `No results for “${term}”. Try a different or shorter word.`
          : `${total} ${total === 1 ? "page matches" : "pages match"} “${term}”${total > MAX_RESULTS ? `. Showing the top ${MAX_RESULTS}.` : "."}`;
      this.setActive(items.length ? 0 : -1, false);
    }

    private option(id: string, url: string, title: string, excerpt: string, section?: string, sub = false) {
      const li = (this.template.content.firstElementChild as HTMLLIElement).cloneNode(true) as HTMLLIElement;
      li.id = id;
      if (sub) li.dataset.sub = "";
      const a = li.querySelector("a")!;
      a.href = url;
      li.querySelector("[data-title]")!.textContent = title;
      li.querySelector("[data-section]")!.textContent = section ?? "";
      // Pagefind escapes the page text and adds <mark> around matches.
      li.querySelector("[data-excerpt]")!.innerHTML = excerpt;
      return li;
    }

    private options(): HTMLElement[] {
      return [...this.list.querySelectorAll<HTMLElement>("[role=option]")];
    }

    private setActive(index: number, scroll = true) {
      const options = this.options();
      this.active = index;
      options.forEach((o, i) => o.setAttribute("aria-selected", String(i === index)));
      const current = options[index];
      if (current) {
        this.input.setAttribute("aria-activedescendant", current.id);
        if (scroll) current.scrollIntoView({ block: "nearest" });
      } else {
        this.input.removeAttribute("aria-activedescendant");
      }
    }

    private setExpanded(expanded: boolean) {
      this.input.setAttribute("aria-expanded", String(expanded));
      if (!expanded) this.input.removeAttribute("aria-activedescendant");
    }

    private onInputKey(e: KeyboardEvent) {
      const options = this.options();
      if (e.key === "ArrowDown" || e.key === "ArrowUp") {
        if (!options.length) return;
        e.preventDefault();
        const step = e.key === "ArrowDown" ? 1 : -1;
        this.setActive((this.active + step + options.length) % options.length);
      } else if (e.key === "Home" && e.ctrlKey) {
        this.setActive(0);
      } else if (e.key === "End" && e.ctrlKey) {
        this.setActive(options.length - 1);
      } else if (e.key === "Enter") {
        e.preventDefault();
        const link = options[this.active]?.querySelector("a");
        if (link) link.click();
      }
    }
  }

  customElements.define("site-search", SiteSearch);
</script>
