---
import MapleLeaf from "./MapleLeaf.astro";
import { t } from "../i18n/en";

const groups = [
  {
    title: t.nav.learn,
    links: [
      { href: "/learn", label: "All modules" },
      { href: "/tour", label: t.nav.tour },
      { href: "/provinces", label: t.nav.provinces },
      { href: "/quizzes", label: t.nav.quizzes },
    ],
  },
  {
    title: t.footer.reference,
    links: [
      { href: "/glossary", label: t.nav.glossary },
      { href: "/timeline", label: t.footer.timeline },
      { href: "/myths", label: t.footer.myths },
      { href: "/sources", label: t.footer.sources },
      { href: "/prime-ministers", label: t.footer.primeMinisters },
      { href: "/governors-general", label: t.footer.governorsGeneral },
      { href: "/demographics", label: t.footer.demographics },
      { href: "/credits", label: t.footer.credits },
      { href: "/about", label: t.footer.about },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-subtle bg-surface-muted">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[2fr_1fr_1fr]">
    <div class="max-w-sm">
      <a href="/" class="flex items-center gap-2 font-semibold text-primary">
        <MapleLeaf class="size-5 text-accent" />
        {t.siteName}
      </a>
      <p class="mt-3 text-sm text-muted">{t.tagline}</p>
      <p class="mt-4 text-sm text-muted">{t.footer.notAffiliated} {t.footer.notAdvice}</p>
    </div>
    {
      groups.map((g) => (
        <nav aria-label={g.title}>
          <h2 class="text-sm font-semibold text-primary">{g.title}</h2>
          <ul class="mt-3 space-y-2">
            {g.links.map((l) => (
              <li>
                <a href={l.href} class="text-sm text-secondary hover:text-accent">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="border-t border-subtle">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs text-muted sm:px-6">
      {t.footer.copyright(year)}
      <a href={t.footer.licenseUrl} rel="license noopener" class="underline decoration-subtle underline-offset-2 hover:text-primary"
        >{t.footer.license}</a
      >.
    </p>
  </div>
</footer>
