---
/**
 * A row under a province or territory page's title: its flag, a locator map
 * and the current premier (src/data/wikidata/provinces.json) with their
 * portrait. The three cards share a height and wrap on narrow screens.
 *
 * The flag comes from public/flags/<slug>.svg. When the file is missing,
 * that card is left out.
 */
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import CanadaMap from "./map/CanadaMap.astro";
import Portrait from "./Portrait.astro";
import { provinceBySlug } from "../lib/reference";
import { provinceFeatures } from "./map/geo";
import type { Page } from "../lib/site";

interface Props {
  page: Page;
}

const { page } = Astro.props;
const slug = page.id.replace(/^provinces\//, "");
const name = page.data.title;
// "the Northwest Territories", but plain "Ontario".
const withArticle = /^Northwest Territories$/.test(name) ? `the ${name}` : name;

const features = provinceFeatures();
if (!features.some((f) => f.properties.slug === slug)) throw new Error(`ProvinceHeader: no map feature for "${slug}"`);

/** Reads the flag's proportions from its viewBox (or width/height) so the <img> reserves the right space. */
function flag(): { src: string; width: number; height: number } | undefined {
  const file = join(process.cwd(), "public", "flags", `${slug}.svg`);
  if (!existsSync(file)) return undefined;
  const head = readFileSync(file, "utf8").slice(0, 4000);
  const svgTag = head.match(/<svg\b[^>]*>/)?.[0] ?? "";
  const viewBox = svgTag.match(/viewBox\s*=\s*["']([^"']+)["']/)?.[1]?.trim().split(/[\s,]+/).map(Number);
  const attr = (n: string) => Number.parseFloat(svgTag.match(new RegExp(`\\b${n}\\s*=\\s*["']([\\d.]+)`))?.[1] ?? "");
  let ratio = 2;
  if (viewBox && viewBox.length === 4 && viewBox[2]! > 0 && viewBox[3]! > 0) ratio = viewBox[2]! / viewBox[3]!;
  else if (attr("width") > 0 && attr("height") > 0) ratio = attr("width") / attr("height");
  const width = 144;
  return { src: `/flags/${slug}.svg`, width, height: Math.round(width / ratio) };
}

const flagImg = flag();
const province = provinceBySlug(slug);
const premier = province?.premier;
---

<div class="province-header not-prose mt-6 flex flex-wrap items-stretch gap-3">
  {
    flagImg && (
      <div class="ph-card flex items-center justify-center p-3">
        <img
          src={flagImg.src}
          width={flagImg.width}
          height={flagImg.height}
          alt={`Flag of ${withArticle}`}
          class="h-full w-auto rounded-sm border border-subtle"
          decoding="async"
        />
      </div>
    )
  }
  <div class="ph-card flex items-center justify-center p-2">
    <CanadaMap
      id="locator"
      features={features}
      width={240}
      padding={3}
      precision={0}
      minArea={6}
      tolerance={1.5}
      role="img"
      title={`Map of Canada with ${withArticle} highlighted`}
      tooltip={false}
      item={(f) => ({ highlight: f.properties.slug === slug, marker: f.properties.slug === slug && "auto" })}
      class="locator"
    />
  </div>
  {
    premier && (
      <figure class="ph-card flex min-w-0 items-center gap-3 px-4">
        <Portrait qid={premier.qid} name={premier.name} size={56} />
        <figcaption class="text-xs leading-snug text-secondary">
          <span class="block font-semibold tracking-wide text-muted uppercase">Premier</span>
          <span class="block text-sm font-semibold text-primary">{premier.name}</span>
          {premier.party ? (
            <span class="block">{premier.party}</span>
          ) : (
            province?.type === "territory" && <span class="block">No party: consensus government</span>
          )}
        </figcaption>
      </figure>
    )
  }
</div>

<style>
  .ph-card {
    height: 7rem;
    border: 1px solid var(--tn-border);
    border-radius: var(--radius-card);
    background: var(--tn-surface);
  }
  /* Fit the card's height (CanadaMap's own rule makes maps full width). */
  .ph-card :global(.canada-map.locator) {
    width: auto;
    height: 100%;
  }
  .locator :global(.map-feature) {
    fill: var(--tn-border);
    stroke: var(--tn-bg);
    stroke-width: 0.75;
  }
  .locator :global(.map-feature.is-highlighted) {
    fill: var(--tn-accent);
    stroke: var(--tn-bg);
  }
</style>
