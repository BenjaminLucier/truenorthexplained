---
/**
 * The pages of a learning module, kept out of the page's own layout so the
 * content can use the full width.
 *
 * - `variant="rail"`: fixed in the empty margin to the left of the content.
 *   Only shown when the window is wide enough for the margin to hold it.
 * - `variant="menu"`: a small "Module · 2 of 5" button (put it in the
 *   breadcrumb row) that opens the same list as a popover. Shown when the
 *   rail isn't.
 */
import Icon from "./Icon.astro";
import ModuleIcon from "./ModuleIcon.astro";
import ProgressRing from "./quiz/ProgressRing.astro";
import { t } from "../i18n/en";
import { href, type Page } from "../lib/site";

interface Props {
  variant: "rail" | "menu";
  mod: { page: Page; deepDives: Page[] };
  current: string;
  questionIds: string[];
}

const { variant, mod, current, questionIds } = Astro.props;
const pages = [mod.page, ...mod.deepDives];
const position = pages.findIndex((p) => p.id === current) + 1;
const label = (p: Page, i: number) => (i === 0 ? `${t.page.moduleOverview}: ${p.data.title}` : p.data.title);
---

{
  variant === "rail" ? (
    <nav aria-label={t.page.inThisModule} class="module-rail">
      <a href={href(mod.page.id)} class="flex items-center gap-2 text-sm font-semibold text-primary hover:text-module">
        <ModuleIcon name={mod.page.data.icon} size="sm" />
        {mod.page.data.title}
      </a>
      <ol class="mt-4 space-y-0.5 border-s border-subtle text-sm">
        {pages.map((p, i) => (
          <li>
            <a
              href={href(p.id)}
              aria-current={p.id === current ? "page" : undefined}
              class="-ms-px block border-s-2 border-transparent py-1.5 ps-3 text-secondary hover:border-strong hover:text-primary aria-[current=page]:border-module aria-[current=page]:font-medium aria-[current=page]:text-module"
            >
              {label(p, i)}
            </a>
          </li>
        ))}
      </ol>
      {questionIds.length > 0 && <ProgressRing ids={questionIds} count="long" class="mt-5 text-xs text-muted" />}
    </nav>
  ) : (
    <div class="module-menu">
      <button
        type="button"
        popovertarget="module-menu"
        class="inline-flex items-center gap-1.5 rounded-full border border-subtle bg-surface px-3 py-1 text-sm text-secondary transition-colors hover:border-accent hover:text-accent"
      >
        <Icon name="ListOrdered" class="size-3.5" />
        <span>
          {t.page.inThisModule}
          <span class="text-muted">{` · ${position} of ${pages.length}`}</span>
        </span>
        <Icon name="ChevronDown" class="size-3.5 opacity-70" />
      </button>
      <nav id="module-menu" popover aria-label={t.page.inThisModule} class="module-menu-pop rounded-card border border-subtle bg-surface p-4 text-primary shadow-card">
        <div class="flex items-center justify-between gap-3">
          <a href={href(mod.page.id)} class="flex items-center gap-2 text-sm font-semibold hover:text-module">
            <ModuleIcon name={mod.page.data.icon} size="sm" />
            {mod.page.data.title}
          </a>
          <ProgressRing ids={questionIds} />
        </div>
        <ol class="mt-3 space-y-1 text-sm">
          {pages.map((p, i) => (
            <li>
              <a
                href={href(p.id)}
                aria-current={p.id === current ? "page" : undefined}
                class="block rounded-md px-2 py-1.5 text-secondary hover:bg-surface-muted hover:text-primary aria-[current=page]:bg-module-soft aria-[current=page]:font-medium aria-[current=page]:text-module"
              >
                {label(p, i)}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  )
}

<style is:global>
  /* The rail needs the content (72rem) plus a 14rem rail and gutters on each side. */
  .module-rail {
    display: none;
  }
  @media (min-width: 106rem) {
    .module-rail {
      display: block;
      position: fixed;
      top: 7rem;
      inset-inline-start: calc((100vw - 72rem) / 2 - 16rem);
      width: 13rem;
      max-height: calc(100dvh - 9rem);
      overflow-y: auto;
    }
    .module-menu {
      display: none;
    }
  }

  .module-menu button {
    anchor-name: --module-menu;
  }
  .module-menu-pop {
    width: min(22rem, calc(100vw - 2rem));
    max-height: min(70dvh, 32rem);
    overflow-y: auto;
    margin: 0;
    inset: 6rem auto auto 50%;
    translate: -50% 0;
  }
  @supports (position-anchor: --module-menu) {
    .module-menu-pop {
      position-anchor: --module-menu;
      inset: anchor(bottom) auto auto anchor(start);
      translate: 0 0.5rem;
      position-try-fallbacks: flip-inline;
    }
  }
</style>
