---
/**
 * Runs before first paint so there's no flash of the wrong theme.
 *
 * The visitor's preference is "system" (the default), "light" or "dark".
 * It's stored in localStorage only when it isn't "system". The preference is
 * exposed as data-theme-pref on <html> (for the toggle's icon) and the
 * resolved theme as data-theme (for styling). While on "system", the page
 * follows OS changes live.
 */
---

<script is:inline>
  (() => {
    const key = "tne-theme";
    const root = document.documentElement;
    const media = matchMedia("(prefers-color-scheme: dark)");
    const read = () => {
      try {
        const v = localStorage.getItem(key);
        return v === "light" || v === "dark" ? v : "system";
      } catch {
        return "system";
      }
    };
    const apply = (pref) => {
      root.dataset.themePref = pref;
      root.dataset.theme = pref === "system" ? (media.matches ? "dark" : "light") : pref;
    };
    window.tneSetTheme = (pref) => {
      try {
        if (pref === "system") localStorage.removeItem(key);
        else localStorage.setItem(key, pref);
      } catch {
        /* storage unavailable: the choice lasts for this page only */
      }
      apply(pref);
    };
    apply(read());
    media.addEventListener("change", () => {
      if (root.dataset.themePref === "system") apply("system");
    });
    // Keep other open tabs in step.
    addEventListener("storage", (e) => {
      if (e.key === key) apply(read());
    });
  })();
</script>
