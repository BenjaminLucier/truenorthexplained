---
/** Renders src/widgets/<name>/index.astro. See src/lib/widgets.ts. */
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

interface Props {
  name: string;
  props?: Record<string, string>;
  /** In-page anchor for links from the Explore page, e.g. "bill-steps". */
  anchor?: string;
}

const widgets = import.meta.glob<{ default: AstroComponentFactory }>("../widgets/*/index.astro", { eager: true });
const { name, props = {}, anchor } = Astro.props;
const Component = widgets[`../widgets/${name}/index.astro`]?.default;
if (!Component) {
  const known = Object.keys(widgets).map((k) => k.split("/")[2]);
  throw new Error(`Unknown widget "${name}". Known widgets: ${known.join(", ")}`);
}
---

{/*
  Pages are full width with prose held to reading width; this wrapper is what
  lets a widget use the whole width (see ContentLayout's article). The anchor
  is an empty marker so widgets keep full control of their own markup.
*/}
<div class="tn-widget">
  {anchor && <span id={anchor} class="block scroll-mt-24" aria-hidden="true"></span>}
  <Component {...props} />
</div>
