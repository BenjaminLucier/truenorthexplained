---
/** A row of legend keys: a line, dashed line, filled box or tinted band, each with a label. */
interface Props {
  items: { label: string; color: string; kind?: "line" | "dashed" | "box" | "band" }[];
  class?: string;
}
const { items, class: className } = Astro.props;
---

<ul class:list={["flex flex-wrap gap-x-5 gap-y-1.5 text-xs text-secondary", className]}>
  {
    items.map((it) => (
      <li class="inline-flex items-center gap-1.5">
        <svg class="h-3 w-5 shrink-0" viewBox="0 0 20 12" aria-hidden="true">
          {(it.kind ?? "line") === "line" && <line x1="1" x2="19" y1="6" y2="6" stroke={it.color} stroke-width="2.5" stroke-linecap="round" />}
          {it.kind === "dashed" && <line x1="1" x2="19" y1="6" y2="6" stroke={it.color} stroke-width="2.5" stroke-dasharray="4 3" />}
          {it.kind === "box" && <rect x="3" y="1" width="14" height="10" rx="2" fill={it.color} />}
          {it.kind === "band" && <rect x="1" y="1" width="18" height="10" rx="2" fill={it.color} fill-opacity={it.color.includes("band") ? 1 : 0.28} />}
        </svg>
        {it.label}
      </li>
    ))
  }
</ul>
