---
/**
 * The site's one chart tooltip: the `<tn-chart>` custom element, its tooltip
 * box and their styles. See ARCHITECTURE.md, "Charts", for the full contract.
 *
 *   <tn-chart role="group" aria-label="…; use the arrow keys to move between years">
 *     <svg>… <rect data-tip="t-1" data-group="1" role="img" aria-label="1867: …" /> …</svg>
 *     <template id="t-1">…tooltip HTML (ct-h, ct-sub, ct-p, ct-rows, ct-sw)…</template>
 *     <span data-tip data-tip-title="Ontario" data-tip-rows='[["Per person","$1,234","var(--tn-data-cat-1)"]]'></span>
 *     <ChartTip />
 *   </tn-chart>
 *
 * Every element with `data-tip` is a stop. Its tooltip is the `<template>` its
 * `data-tip` names, or, when `data-tip` is empty, one built from
 * `data-tip-title`, `data-tip-sub`, `data-tip-rows` (JSON `[label, value?,
 * colour?][]`) and `data-tip-note`. A stop without an `aria-label` is named from
 * that text, and gets `role="img"` if it has no role.
 *
 * Mouse: hovering a stop shows its tooltip beside the pointer. Touch and pen:
 * tapping (or dragging across) a stop shows it above the stop; tapping
 * elsewhere hides it. Keyboard: the chart is one tab stop (the stop with
 * `data-start`, else the first); the arrow keys, Home, End, PageUp and
 * PageDown move between stops, and Escape hides the tooltip. Stops with a
 * `data-row` form rows: Up and Down move to the nearest stop in the next row.
 * With `data-nav="grid"` on the chart, the arrow keys move to the nearest stop
 * on screen in that direction instead (for grids whose layout changes with
 * width), and Home and End stay within the stop's `data-row`. Stops that
 * aren't rendered (`display: none`) are skipped.
 *
 * Every element sharing the stop's `data-group` gets `.is-active`, and the
 * chart gets `data-active`, so a chart can highlight a column, a point or a
 * crosshair. With `data-tip-place="side"` on the chart, the tooltip sits
 * beside the stop (or beside the element in its group marked
 * `data-tip-anchor`, such as a crosshair line), flipping sides past the middle,
 * for every kind of pointer. The tooltip itself is `aria-hidden`: each stop's
 * accessible name carries the same facts, and the chart's table has them all.
 */
---

<div class="ct-tip" aria-hidden="true" hidden></div>

<style is:global>
  tn-chart {
    display: block;
    position: relative;
  }
  tn-chart [data-tip] {
    cursor: default;
  }
  /* SVG stops show focus through their own `.is-active` and :focus-visible styles. */
  tn-chart svg [data-tip]:focus {
    outline: none;
  }
  .ct-tip {
    position: absolute;
    z-index: 20;
    top: 0;
    left: 0;
    width: max-content;
    max-width: min(17rem, 100%);
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--tn-border);
    border-radius: 0.625rem;
    background: var(--tn-surface);
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.14);
    color: var(--tn-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
    text-align: start;
    pointer-events: none;
  }
  .ct-tip[hidden] {
    display: none;
  }
  .ct-tip .ct-h {
    font-weight: 700;
    color: var(--tn-text-primary);
  }
  .ct-tip .ct-sub {
    margin-top: 0.125rem;
    font-size: 0.75rem;
    color: var(--tn-text-muted);
  }
  .ct-tip .ct-p {
    margin-top: 0.375rem;
  }
  .ct-tip .ct-rows {
    margin-top: 0.5rem;
    width: 100%;
    border-collapse: collapse;
  }
  .ct-tip .ct-h + .ct-rows {
    margin-top: 0.25rem;
  }
  .ct-tip .ct-rows td {
    padding: 0.125rem 0;
    vertical-align: baseline;
  }
  .ct-tip .ct-rows td + td {
    padding-left: 0.75rem;
    text-align: end;
    white-space: nowrap;
  }
  .ct-tip .ct-rows .ct-strong td,
  .ct-tip .ct-rows .ct-v {
    color: var(--tn-text-primary);
    font-weight: 600;
  }
  .ct-tip .ct-sw {
    display: inline-block;
    width: 0.625rem;
    height: 0.625rem;
    margin-right: 0.375rem;
    border-radius: 0.1875rem;
    vertical-align: -0.0625rem;
    background: var(--sw);
  }
</style>

<script>
  type Stop = HTMLElement | SVGElement;
  type Row = [label: string, value?: string | null, colour?: string | null];
  const GAP = 14;

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, text?: string) => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  };
  const rowsOf = (stop: Stop): Row[] => {
    try {
      return stop.dataset.tipRows ? (JSON.parse(stop.dataset.tipRows) as Row[]) : [];
    } catch {
      return [];
    }
  };

  /** Tooltip content built from a stop's data-tip-title / -sub / -rows / -note. */
  function fromData(stop: Stop): Node[] {
    const d = stop.dataset;
    const out: Node[] = [];
    if (d.tipTitle) out.push(el("p", "ct-h", d.tipTitle));
    if (d.tipSub) out.push(el("p", "ct-sub", d.tipSub));
    const rows = rowsOf(stop);
    if (rows.length) {
      const table = el("table", "ct-rows");
      const body = table.createTBody();
      for (const [label, value, colour] of rows) {
        const tr = body.insertRow();
        const td = tr.insertCell();
        if (colour) {
          const sw = el("span", "ct-sw");
          sw.style.setProperty("--sw", colour);
          td.append(sw);
        }
        td.append(label);
        if (value == null || value === "") td.colSpan = 2;
        else tr.insertCell().textContent = value;
      }
      out.push(table);
    }
    if (d.tipNote) out.push(el("p", "ct-sub", d.tipNote));
    return out;
  }

  /** A plain-text version of a stop's tooltip, for its accessible name. */
  function textOf(stop: Stop): string {
    const d = stop.dataset;
    if (d.tip) {
      const tpl = document.getElementById(d.tip);
      if (!(tpl instanceof HTMLTemplateElement)) return "";
      const parts: string[] = [];
      const walk = (n: Node) => {
        if (n.nodeType === Node.TEXT_NODE) parts.push(n.textContent ?? "");
        else n.childNodes.forEach(walk);
      };
      walk(tpl.content);
      return parts.join(" ").replace(/\s+/g, " ").replace(/ ([,.:;])/g, "$1").trim();
    }
    const rows = rowsOf(stop).map(([label, value]) => (value ? `${label}: ${value}` : label));
    return [d.tipTitle, d.tipSub, ...rows, d.tipNote].filter(Boolean).join(". ");
  }

  const shown = (s: Element) => s.getClientRects().length > 0;
  const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(v, hi));
  const centre = (s: Element) => {
    const r = s.getBoundingClientRect();
    return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
  };

  class TnChart extends HTMLElement {
    #active: Stop | null = null;

    connectedCallback() {
      const tip = this.querySelector<HTMLElement>(":scope .ct-tip");
      const all = [...this.querySelectorAll<Stop>("[data-tip]")];
      if (!tip || !all.length) return;
      const stops = () => all.filter(shown);
      const start = all.find((s) => s.hasAttribute("data-start") && shown(s)) ?? stops()[0] ?? all[0]!;
      for (const s of all) {
        s.setAttribute("tabindex", s === start ? "0" : "-1");
        if (!s.hasAttribute("role")) s.setAttribute("role", "img");
        if (!s.hasAttribute("aria-label")) s.setAttribute("aria-label", textOf(s));
      }
      const side = this.dataset.tipPlace === "side";
      const grid = this.dataset.nav === "grid";

      const clear = () => {
        for (const a of this.querySelectorAll(".is-active")) a.classList.remove("is-active");
        delete this.dataset.active;
      };

      const show = (stop: Stop, point?: { x: number; y: number }) => {
        if (this.#active !== stop) {
          clear();
          this.#active = stop;
          const tpl = stop.dataset.tip ? document.getElementById(stop.dataset.tip) : null;
          if (tpl instanceof HTMLTemplateElement) tip.replaceChildren(tpl.content.cloneNode(true));
          else if (stop.dataset.tipTitle || stop.dataset.tipRows) tip.replaceChildren(...fromData(stop));
          else tip.replaceChildren(stop.getAttribute("aria-label") ?? "");
          const group = stop.dataset.group;
          if (group) for (const g of this.querySelectorAll(`[data-group="${CSS.escape(group)}"]`)) g.classList.add("is-active");
          stop.classList.add("is-active");
          this.dataset.active = group ?? "";
        }
        tip.hidden = false;
        place(stop, point);
      };

      const hide = () => {
        clear();
        this.#active = null;
        tip.hidden = true;
      };

      const anchorOf = (stop: Stop): Element => {
        const group = stop.dataset.group;
        return (group && this.querySelector(`[data-group="${CSS.escape(group)}"][data-tip-anchor]`)) || stop;
      };

      const place = (stop: Stop, point?: { x: number; y: number }) => {
        const box = this.getBoundingClientRect();
        const w = tip.offsetWidth;
        const h = tip.offsetHeight;
        const r = anchorOf(stop).getBoundingClientRect();
        let x: number;
        let y: number;
        if (side) {
          // Beside the anchor, on the side with more room, level with its middle.
          const ax = r.left - box.left + r.width / 2;
          x = ax > box.width / 2 ? ax - w - 12 : ax + 12;
          y = clamp(r.top - box.top + r.height / 2 - h / 2, 0, Math.max(0, box.height - h));
        } else if (point) {
          x = point.x - box.left + GAP;
          y = point.y - box.top + GAP;
          if (x + w > box.width) x = point.x - box.left - GAP - w;
          if (y + h > box.height) y = point.y - box.top - GAP - h;
        } else {
          // Centred above the stop, or below it if there's no room above.
          x = r.left - box.left + r.width / 2 - w / 2;
          y = r.top - box.top - h - 8;
          if (y < 0 && r.bottom - box.top + 8 + h <= box.height) y = r.bottom - box.top + 8;
        }
        x = clamp(x, 0, box.width - w);
        tip.style.transform = `translate(${Math.round(x)}px, ${Math.round(y)}px)`;
      };

      const stopFrom = (e: Event) => (e.target as Element).closest?.<Stop>("[data-tip]") ?? null;
      const stopAt = (x: number, y: number) => {
        const s = document.elementFromPoint(x, y)?.closest<Stop>("[data-tip]");
        return s && this.contains(s) ? s : null;
      };

      this.addEventListener("pointermove", (e) => {
        if (e.pointerType !== "mouse") {
          // A finger or pen dragging across the chart (touch events stay
          // targeted at the first element, so look under the point).
          const stop = e.buttons ? stopAt(e.clientX, e.clientY) : null;
          if (stop) show(stop);
          return;
        }
        const stop = stopFrom(e);
        if (stop) show(stop, { x: e.clientX, y: e.clientY });
        else if (this.#active && !this.contains(document.activeElement)) hide();
      });
      this.addEventListener("pointerleave", (e) => {
        if (e.pointerType === "mouse" && !this.contains(document.activeElement)) hide();
      });
      this.addEventListener("pointerdown", (e) => {
        if (e.pointerType === "mouse") return;
        const stop = stopFrom(e);
        if (stop) show(stop);
      });
      document.addEventListener("pointerdown", (e) => {
        if (e.pointerType !== "mouse" && this.#active && !this.contains(e.target as Node)) hide();
      });

      const focus = (stop: Stop | undefined) => {
        if (!stop) return;
        for (const s of all) s.setAttribute("tabindex", s === stop ? "0" : "-1");
        // A chart that scrolls sideways (a long timeline strip) brings the stop into
        // view first, so the tooltip that focusing shows lands next to it.
        for (let el = stop.parentElement; el && el !== this; el = el.parentElement) {
          if (el.scrollWidth <= el.clientWidth + 1) continue;
          const box = el.getBoundingClientRect();
          const sr = stop.getBoundingClientRect();
          if (sr.left < box.left || sr.right > box.right) {
            el.scrollLeft += sr.left + sr.width / 2 - (box.left + box.width / 2);
          }
          break;
        }
        stop.focus({ preventScroll: true });
        const r = stop.getBoundingClientRect();
        if (r.top < 0 || r.bottom > innerHeight) stop.scrollIntoView({ block: "nearest" });
      };
      this.addEventListener("focusin", (e) => {
        const stop = stopFrom(e);
        if (!stop) return;
        for (const s of all) s.setAttribute("tabindex", s === stop ? "0" : "-1");
        show(stop);
      });
      this.addEventListener("focusout", (e) => {
        if (!this.contains(e.relatedTarget as Node | null)) hide();
      });

      /** The nearest stop on screen in an arrow key's direction. */
      const toward = (from: Stop, list: Stop[], key: string) => {
        const c = centre(from);
        const dx = key === "ArrowRight" ? 1 : key === "ArrowLeft" ? -1 : 0;
        const dy = key === "ArrowDown" ? 1 : key === "ArrowUp" ? -1 : 0;
        let best: Stop | undefined;
        let cost = Infinity;
        for (const s of list) {
          const p = centre(s);
          const along = (p.x - c.x) * dx + (p.y - c.y) * dy;
          if (along < 1) continue;
          const off = Math.abs((p.x - c.x) * dy) + Math.abs((p.y - c.y) * dx);
          const k = along + 4 * off;
          if (k < cost) [best, cost] = [s, k];
        }
        return best;
      };

      this.addEventListener("keydown", (e) => {
        const current = stopFrom(e);
        if (!current) return;
        const list = stops();
        const i = list.indexOf(current);
        const page = Math.max(1, Math.round(list.length / 10));
        const row = current.dataset.row;
        const arrow = e.key.startsWith("Arrow");
        let next: Stop | undefined;
        if (grid && arrow) {
          next = toward(current, list, e.key);
          if (!next) return e.preventDefault();
        } else if (grid && row !== undefined && (e.key === "Home" || e.key === "End")) {
          const same = list.filter((s) => s.dataset.row === row);
          next = e.key === "Home" ? same[0] : same.at(-1);
        } else if ((e.key === "ArrowUp" || e.key === "ArrowDown") && row !== undefined) {
          const target = Number(row) + (e.key === "ArrowDown" ? 1 : -1);
          const x = centre(current).x;
          next = list
            .filter((s) => Number(s.dataset.row) === target)
            .sort((a, b) => Math.abs(centre(a).x - x) - Math.abs(centre(b).x - x))[0];
          if (!next) return;
        } else if (e.key === "ArrowRight" || e.key === "ArrowDown") next = list[Math.min(i + 1, list.length - 1)];
        else if (e.key === "ArrowLeft" || e.key === "ArrowUp") next = list[Math.max(i - 1, 0)];
        else if (e.key === "PageDown") next = list[Math.min(i + page, list.length - 1)];
        else if (e.key === "PageUp") next = list[Math.max(i - page, 0)];
        else if (e.key === "Home") next = list[0];
        else if (e.key === "End") next = list.at(-1);
        else if (e.key === "Escape") {
          if (this.#active) {
            hide();
            e.preventDefault();
          }
          return;
        } else return;
        e.preventDefault();
        focus(next);
      });

      // A tooltip placed for one width is wrong at another.
      new ResizeObserver(() => {
        if (this.#active) place(this.#active);
      }).observe(this);
    }
  }

  if (!customElements.get("tn-chart")) customElements.define("tn-chart", TnChart);
</script>
