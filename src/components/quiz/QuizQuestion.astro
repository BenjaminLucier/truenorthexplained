---
import { t } from "../../i18n/en";
import type { Question } from "../../lib/site";

interface Props {
  question: Question;
  number?: number;
}

const { question, number } = Astro.props;
const q = question.data;
const isTF = q.type === "true-false";
const options = isTF ? [t.quiz.trueLabel, t.quiz.falseLabel] : (q.options ?? []);
const correctIndexes: number[] = isTF
  ? [q.answer === true ? 0 : 1]
  : Array.isArray(q.answer)
    ? q.answer
    : [q.answer as number];
const answerText = correctIndexes.map((i) => options[i]).join("; ");
const inputType = q.type === "multi" ? "checkbox" : "radio";
const name = `q-${q.id}`;
---

<quiz-question
  data-id={q.id}
  data-pages={q.pages.join(" ")}
  data-answer={JSON.stringify(correctIndexes)}
  class="block"
>
  <form class="rounded-card border border-subtle bg-surface p-5 shadow-card sm:p-6">
    <fieldset>
      <legend class="flex gap-3 text-base font-semibold text-primary">
        {number !== undefined && <span class="text-muted tabular-nums">{number}.</span>}
        <span>{q.question}</span>
      </legend>
      <p class="mt-1 text-sm text-muted">{q.type === "multi" ? t.quiz.chooseAll : t.quiz.chooseOne}</p>
      <p data-history hidden class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-surface-muted px-2.5 py-1 text-xs font-medium text-secondary"></p>
      <div class="mt-4 grid gap-2">
        {
          options.map((option, i) => (
            <label data-option={i} class="quiz-option group">
              <input type={inputType} name={name} value={i} required={inputType === "radio"} />
              <span class="flex-1">{option}</span>
              <svg class="quiz-mark quiz-mark-correct" aria-hidden="true"><use href="#tn-check" /></svg>
              <svg class="quiz-mark quiz-mark-incorrect" aria-hidden="true"><use href="#tn-x" /></svg>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="mt-4 flex flex-wrap items-center gap-3">
      <button
        type="submit"
        data-check
        class="rounded-full bg-accent px-5 py-2 text-sm font-semibold text-accent-contrast transition-colors hover:bg-accent-hover"
      >
        {t.quiz.check}
      </button>
      <button
        type="button"
        data-retry
        hidden
        class="rounded-full border border-strong px-5 py-2 text-sm font-semibold text-primary hover:bg-surface-muted"
      >
        {t.quiz.tryAgain}
      </button>
    </div>

    <div data-feedback role="status" aria-live="polite"></div>
    <template data-feedback-template>
      <div class="mt-4 rounded-lg border-s-4 bg-surface-muted p-4 text-sm data-[result=correct]:border-success data-[result=incorrect]:border-danger">
        <p class="font-semibold text-primary">
          <span data-result-label></span>
          <span class="font-normal text-secondary"> {t.quiz.answer}: {answerText}.</span>
        </p>
        <p class="mt-2 text-secondary">{q.explanation}</p>
        <a href={q.source} rel="noopener" class="mt-2 inline-block text-accent underline underline-offset-3">
          {t.quiz.source} ↗
        </a>
      </div>
    </template>
  </form>
</quiz-question>
