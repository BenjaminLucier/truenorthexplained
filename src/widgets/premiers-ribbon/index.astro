---
/**
 * Which party family has governed each province and territory since it
 * joined Canada: one ribbon per province or territory, one block per
 * premier, coloured by the party family of their government. From
 * src/data/wikidata/premiers.json (`pnpm data:premiers`).
 *
 *   <tn-widget name="premiers-ribbon"></tn-widget>
 *
 * The ribbon itself (Ribbon.astro) and its table (RibbonTable.astro) are
 * shared with the province profile, which draws one province's row.
 *
 * Palette (src/lib/party-families.ts, tokens in src/styles/global.css):
 * Liberal, Conservative, CCF / NDP and Social Credit use the federal party
 * colours, as does the Parti Québécois (the Bloc's colour). The other
 * provincial families have their own tokens: the Quebec autonomist parties
 * (Union Nationale, CAQ), the centre-right coalitions (BC Liberals since
 * 1991, Saskatchewan Party), the farmer and Progressive governments, and
 * non-partisan or consensus government. Hatching marks years with no
 * premier or government leader.
 */
import ChartCard from "../../components/charts/ChartCard.astro";
import { uniqueId } from "../../lib/ids";
import { PROVINCIAL, buildDate, type ProvincialFamily } from "../../lib/election-history";
import { governmentRuns, longestRun, runYears } from "../../lib/province-profile";
import Ribbon from "./Ribbon.astro";
import RibbonTable from "./RibbonTable.astro";
import { RIBBON_ORDER, governmentsFor } from "./rows";

const id = uniqueId(Astro, "premiers", "ribbon");
const govs = RIBBON_ORDER.map((r) => governmentsFor(r.slug));

// The longest unbroken run of one party in one province (by days).
const runs = govs.flatMap((p) => governmentRuns(p.terms, buildDate).map((r) => ({ ...r, p })));
const longest = longestRun(runs, buildDate) as (typeof runs)[number] | undefined;
if (!longest) throw new Error("premiers-ribbon: no party governments in the data");
const current = govs.map((p) => ({ p, t: p.terms.at(-1)! })).filter(({ t }) => t.end === null);
const NOW: Partial<Record<ProvincialFamily, string>> = { ndp: "NDP", coalition: "centre-right coalition", autonomist: "Quebec autonomist" };
const partisan = new Map<ProvincialFamily, number>();
for (const { t } of current) if (t.family !== "nonpartisan") partisan.set(t.family, (partisan.get(t.family) ?? 0) + 1);
const consensus = current.filter(({ t }) => t.family === "nonpartisan").map(({ p }) => (p.name.startsWith("Northwest") ? `the ${p.name}` : p.name));
const currentText =
  [...partisan]
    .sort((a, b) => b[1] - a[1])
    .map(([f, n]) => `${n} ${NOW[f] ?? PROVINCIAL[f].label}`)
    .join(", ") + (consensus.length ? `, and consensus government in ${consensus.join(" and ")}` : "");
const lede = `The longest unbroken run belongs to ${longest.p.name}'s ${longest.party}s: ${runYears(longest, buildDate)} years and ${longest.n} premiers, from ${longest.start.slice(0, 4)} to ${longest.end ? longest.end.slice(0, 4) : "today"}. Today's governments: ${currentText}.`;
---

<ChartCard
  title="Who has governed the provinces and territories"
  lede={lede}
  sources={[
    { label: "Wikidata, premiers of each province and territory (CC0)", url: "https://www.wikidata.org/" },
    { label: "Wikipedia, lists of premiers and their articles (CC BY-SA 4.0)", url: "https://en.wikipedia.org/wiki/List_of_current_Canadian_first_ministers" },
  ]}
  tableLabel="Show the data"
>
  <Ribbon id={id} />

  <Fragment slot="table">
    <RibbonTable />
  </Fragment>
</ChartCard>
