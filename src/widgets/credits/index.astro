---
/**
 * Data sources and flag attributions, read from each dataset's `_meta` block
 * and src/data/flags.json, so the credits stay in step with the data.
 *
 *   <tn-widget name="credits" data-part="datasets"></tn-widget>
 *   <tn-widget name="credits" data-part="flags"></tn-widget>
 */
import { datasets, flags, formatDate } from "../../lib/reference";

interface Props {
  part: "datasets" | "flags";
}
const { part } = Astro.props;

const link = "underline decoration-accent/40 underline-offset-3 hover:text-accent hover:decoration-accent";
const licenceLinks: Record<string, string> = {
  "CC0 1.0 (Wikidata)": "https://creativecommons.org/publicdomain/zero/1.0/",
  "Open Government Licence – Canada": "https://open.canada.ca/en/open-government-licence-canada",
};
// The flags dataset is covered in its own section.
const rows = datasets.filter((d) => d.id !== "flags");
---

{
  part === "datasets" && (
    <div class="not-prose my-8 overflow-x-auto rounded-lg border border-subtle">
      <table class="w-full min-w-[40rem] text-sm">
        <caption class="sr-only">Datasets used on this site, with their source, licence and when they were fetched</caption>
        <thead class="bg-surface-muted text-primary">
          <tr>
            <th scope="col" class="px-3 py-2 ps-4 text-start font-semibold">Dataset</th>
            <th scope="col" class="px-3 py-2 text-start font-semibold">Source</th>
            <th scope="col" class="px-3 py-2 text-start font-semibold">Licence</th>
            <th scope="col" class="px-3 py-2 pe-4 text-start font-semibold">Fetched</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-subtle text-secondary">
          {rows.map((d) => {
            const urls = d.meta.urls ?? [d.meta.url];
            return (
              <tr class="align-top">
                <th scope="row" class="px-3 py-2.5 ps-4 text-start font-medium text-primary">
                  {d.title}
                  <code class="mt-0.5 block text-xs font-normal text-muted">{d.file}</code>
                </th>
                <td class="px-3 py-2.5">
                  {d.meta.source}
                  <span class="mt-0.5 block text-xs">
                    {urls.map((u, i) => (
                      <>
                        {i > 0 && " · "}
                        <a href={u} class={link}>
                          {new URL(u).hostname.replace(/^www\d*\./, "")}
                          {urls.length > 1 && ` (${i + 1})`}
                        </a>
                      </>
                    ))}
                  </span>
                </td>
                <td class="px-3 py-2.5">
                  {licenceLinks[d.meta.licence] || d.meta.licenceUrl ? (
                    <a href={licenceLinks[d.meta.licence] ?? d.meta.licenceUrl} class={link}>
                      {d.meta.licence}
                    </a>
                  ) : (
                    d.meta.licence
                  )}
                </td>
                <td class="px-3 py-2.5 pe-4 whitespace-nowrap tabular-nums">{formatDate(d.meta.fetched, "short")}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )
}

{
  part === "flags" && (
    <ul class="not-prose my-8 grid gap-3 sm:grid-cols-2">
      {flags.map((f) => (
        <li class="flex gap-4 rounded-card border border-subtle bg-surface p-4">
          <img
            src={f.path}
            alt=""
            width="64"
            height="32"
            loading="lazy"
            class="h-8 w-16 shrink-0 rounded-sm border border-subtle object-cover"
          />
          <div class="min-w-0 text-sm">
            <p class="font-semibold text-primary">Flag of {f.name}</p>
            <p class="mt-1 text-secondary">
              {f.licenceUrl ? (
                <a href={f.licenceUrl} class={link}>
                  {f.licence}
                </a>
              ) : (
                f.licence
              )}
              {f.author && <span class="text-muted"> · {f.author}</span>}
            </p>
            <p class="mt-1 text-xs">
              <a href={f.commonsUrl} class={link}>
                {f.commonsFile}
                <span class="sr-only"> on Wikimedia Commons</span>
              </a>
            </p>
          </div>
        </li>
      ))}
    </ul>
  )
}
