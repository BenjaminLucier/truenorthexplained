    overflow: hidden;
  }
  .re-details .re-bar > span {
    display: block;
    height: 100%;
    min-width: 2px;
    border-radius: 9999px;
    background: var(--swatch);
  }
  .re-details dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.25rem 0.75rem;
  }
  .re-details dt {
    color: var(--tn-text-muted);
  }
  .re-details dd {
    text-align: end;
    font-variant-numeric: tabular-nums;
    color: var(--tn-text-primary);
  }
  .re-details .re-link {
    color: var(--tn-accent);
    font-weight: 500;
  }
  .re-details .re-link:hover {
    color: var(--tn-accent-hover);
  }
  .re .re-dot {
    flex: none;
    display: inline-block;
    width: 0.625rem;
    height: 0.625rem;
    margin-inline-end: 0.375rem;
    border-radius: 9999px;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tn-text-primary) 15%, transparent);
  }
</style>

<script>
  import type { Photo, RidingResult } from "./data";
  import { SILHOUETTE_SVG } from "../../lib/portrait-fallback";

  type Source = "map" | "search" | "locate" | "table" | "hash";
  interface ResultsFile {
    _meta: { membersAsOf: string };
    ridings: RidingResult[];
  }

  const PARTY: Record<string, string> = {
    lpc: "Liberal",
    cpc: "Conservative",
    bq: "Bloc Québécois",
    ndp: "NDP",
    gpc: "Green",
    other: "Other",
  };
  const PROVINCE: Record<string, string> = {
    NL: "Newfoundland and Labrador",
    PE: "Prince Edward Island",
    NS: "Nova Scotia",
    NB: "New Brunswick",
    QC: "Quebec",
    ON: "Ontario",
    MB: "Manitoba",
    SK: "Saskatchewan",
    AB: "Alberta",
    BC: "British Columbia",
    YT: "Yukon",
    NT: "Northwest Territories",
    NU: "Nunavut",
  };
  const num = new Intl.NumberFormat("en-CA");
  const fold = (s: string) =>
    s
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "")
      .toLowerCase()
      .replace(/[—–-]+/g, " ")
      .replace(/[^a-z0-9 ]/g, "")
      .replace(/\s+/g, " ")
      .trim();
  const date = (iso: string) => {
    const [y, m, d] = iso.split("-").map(Number) as [number, number, number];
    return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
  };

  /** Tiny element builder: h("p", { class: "x" }, "text", child). */
  function h(tag: string, attrs: Record<string, string | undefined> = {}, ...children: (Node | string | null | false | undefined)[]) {
    const el = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) if (v !== undefined) el.setAttribute(k, v);
    for (const c of children) if (c) el.append(c);
    return el;
  }
  const nameOf = (fed: number) => document.querySelector(`#r-${fed} th`)?.textContent?.trim() ?? "";
  const dot = (party: string) => h("span", { class: "re-dot", style: `--swatch:var(--tn-party-${party})`, "aria-hidden": "true" });
  /** The same markup as components/Portrait.astro: a photo, or the empty portrait when there's none. */
  function portrait(photo: Photo | undefined, name: string, size: number) {
    const frame = h("span", { class: "tn-portrait", style: `--portrait-size:${size}px` });
    if (photo) {
      const src = (s: number) => `/portraits/${photo.qid}-${s}.webp`;
      frame.append(
        h("img", { src: src(96), srcset: `${src(96)} 96w, ${src(240)} 240w`, sizes: `${size}px`, width: String(size), height: String(size), alt: name, title: photo.credit, decoding: "async" }),
      );
    } else {
      frame.setAttribute("role", "img");
      frame.setAttribute("aria-label", name);
      frame.title = `${name}: no free photo available`;
      frame.innerHTML = SILHOUETTE_SVG;
    }
    return frame;
  }

  class RidingsExplorer extends HTMLElement {
    #results?: Promise<ResultsFile>;
    #byFed = new Map<number, RidingResult>();
    #selected?: number;
    #status!: HTMLElement;
    #panel!: HTMLElement;
    #details!: HTMLElement;

    connectedCallback() {
      this.#status = this.querySelector(".re-status")!;
      this.#panel = this.querySelector(".re-panel")!;
      this.#details = this.querySelector(".re-details")!;

      this.#setUpMaps();
      this.querySelector(".re-views")!.addEventListener("change", () => {
        if (this.#selected) this.#highlight(this.#selected);
      });
      this.#setUpSearch();
      this.#setUpLocate();
      this.#setUpTable();

      // Fetch the results as soon as the reader shows interest, so the panel is instant.
      const warm = () => void this.#load().catch(() => {});
      this.addEventListener("pointerenter", warm, { once: true });
      this.addEventListener("focusin", warm, { once: true });

      this.dataset.ready = "";
      this.#fromHash();
      window.addEventListener("hashchange", () => this.#fromHash());
    }

    // --- Data -------------------------------------------------------------

    #load(): Promise<ResultsFile> {
      this.#results ??= fetch(this.dataset.results!)
        .then((r) => {
          if (!r.ok) throw new Error(`HTTP ${r.status}`);
          return r.json() as Promise<ResultsFile>;
        })
        .then((data) => {
          for (const r of data.ridings) this.#byFed.set(r.fed, r);
          return data;
        })
        .catch((e) => {
          this.#results = undefined;
          throw e;
        });
      return this.#results;
    }

    #say(text: string) {
      this.#status.textContent = text;
    }

    // --- Maps -------------------------------------------------------------

    #view(): string {
      return this.querySelector<HTMLInputElement>('.re-views input:checked')?.value ?? "canada";
    }

    #setView(view: string) {
      const input = this.querySelector<HTMLInputElement>(`.re-views input[value="${view}"]`);
      if (input && !input.checked) input.checked = true;
    }

    #setUpMaps() {
      const stage = this.querySelector<HTMLElement>(".re-stage")!;
      const tip = this.querySelector<HTMLElement>(".re-tip")!;
      const fine = window.matchMedia("(hover: hover) and (pointer: fine)");

      for (const svg of this.querySelectorAll<SVGSVGElement>(".re-map svg")) {
        const links = [...svg.querySelectorAll<SVGAElement>("a.map-link")];
        // Chrome can make a clipped SVG a tab stop of its own; the links are the only stop wanted.
        svg.setAttribute("tabindex", "-1");
        if (links[0]) links[0].setAttribute("tabindex", "0");
        let centres: { link: SVGAElement; x: number; y: number }[] | undefined;
        const centresOf = () =>
          (centres ??= links.map((link) => {
            const b = (link.firstElementChild as SVGGraphicsElement).getBBox();
            return { link, x: b.x + b.width / 2, y: b.y + b.height / 2 };
          }));

        svg.addEventListener("click", (e) => {
          const target = e.target as Element;
          const box = target.closest<SVGElement>(".re-box");
          if (box) {
            this.#setView(box.dataset.inset!);
            tip.removeAttribute("data-shown");
            return;
          }
          const link = target.closest<SVGAElement>("a.map-link");
          if (!link) return;
          e.preventDefault();
          this.select(Number(link.dataset.fed), "map");
        });

        svg.addEventListener("focusin", (e) => {
          const link = (e.target as Element).closest<SVGAElement>("a.map-link");
          if (!link) return;
          for (const l of links) l.setAttribute("tabindex", l === link ? "0" : "-1");
          if (link.matches(":focus-visible")) this.dataset.focusVisible = "";
          if (Number(link.dataset.fed) !== this.#selected) this.select(Number(link.dataset.fed), "map");
        });
        svg.addEventListener("focusout", () => delete this.dataset.focusVisible);

        svg.addEventListener("keydown", (e) => {
          const link = (e.target as Element).closest<SVGAElement>("a.map-link");
          if (!link) return;
          const dirs: Record<string, [number, number]> = {
            ArrowRight: [1, 0],
            ArrowLeft: [-1, 0],
            ArrowDown: [0, 1],
            ArrowUp: [0, -1],
          };
          let next: SVGAElement | undefined;
          if (e.key === "Home") next = links[0];
          else if (e.key === "End") next = links.at(-1);
          else if (dirs[e.key]) {
            const [dx, dy] = dirs[e.key]!;
            const all = centresOf();
            const here = all.find((c) => c.link === link)!;
            let best = Infinity;
            for (const c of all) {
              if (c.link === link) continue;
              const vx = c.x - here.x;
              const vy = c.y - here.y;
              const along = vx * dx + vy * dy;
              if (along <= 0) continue;
              const across = Math.abs(vx * dy - vy * dx);
              if (across > along * 2) continue;
              const score = along + across * 2;
              if (score < best) {
                best = score;
                next = c.link;
              }
            }
          } else if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            this.select(Number(link.dataset.fed), "map");
            return;
          } else return;
          e.preventDefault();
          next?.focus();
        });

        // A small tooltip with the riding's name, for mouse users.
        svg.addEventListener("pointermove", (e) => {
          if (e.pointerType !== "mouse" || !fine.matches) return;
          const target = e.target as Element;
          const link = target.closest<SVGAElement>("a.map-link");
          const box = target.closest<SVGElement>(".re-box");
          const text = link?.getAttribute("aria-label") ?? box?.dataset.label;
          if (!text) {
            tip.removeAttribute("data-shown");
            return;
          }
          if (tip.textContent !== text) tip.textContent = text;
          const r = stage.getBoundingClientRect();
          let x = e.clientX - r.left + 14;
          let y = e.clientY - r.top + 14;
          if (x + tip.offsetWidth > r.width) x = Math.max(0, x - tip.offsetWidth - 28);
          if (y + tip.offsetHeight > r.height) y = Math.max(0, y - tip.offsetHeight - 28);
          tip.style.transform = `translate(${Math.round(x)}px, ${Math.round(y)}px)`;
          tip.dataset.shown = "";
        });
        svg.addEventListener("pointerleave", () => tip.removeAttribute("data-shown"));
      }
    }

    #highlight(fed: number) {
      for (const el of this.querySelectorAll(".is-selected")) el.classList.remove("is-selected");
      for (const svg of this.querySelectorAll<SVGSVGElement>(".re-map svg")) {
        const link = svg.querySelector<SVGAElement>(`a.map-link[data-fed="${fed}"]`);
        const outline = svg.querySelector<SVGPathElement>(".re-outline")!;
        const path = link?.querySelector("path");
        outline.setAttribute("d", path?.getAttribute("d") ?? "");
        // Ring a riding that's too small to spot. Hidden maps can't be measured; they're redone when shown.
        const ring = svg.querySelector<SVGCircleElement>(".re-ring")!;
        const box = path && svg.getBoundingClientRect().width > 0 ? path.getBBox() : undefined;
        const size = box ? Math.max(box.width, box.height) : Infinity;
        ring.setAttribute("r", size < 14 ? String(Math.max(size / 2 + 6, 10)) : "0");
        if (box) {
          ring.setAttribute("cx", String(box.x + box.width / 2));
          ring.setAttribute("cy", String(box.y + box.height / 2));
        }
        if (link) {
          link.classList.add("is-selected");
          // Keep the map's single tab stop on the selected riding.
          for (const l of svg.querySelectorAll("a.map-link")) l.setAttribute("tabindex", l === link ? "0" : "-1");
        }
      }
      this.querySelector(`#r-${fed}`)?.classList.add("is-selected");
    }

    // --- Selection --------------------------------------------------------

    async select(fed: number, source: Source) {
      this.#selected = fed;
      this.#highlight(fed);

      if (source !== "map") {
        // Show the riding where it can be seen: its city inset, or the whole country.
        const link = this.querySelector<SVGAElement>(`.re-map[data-view="canada"] a.map-link[data-fed="${fed}"]`);
        const inset = link?.dataset.inset;
        const view = this.#view();
        if (inset) this.#setView(inset);
        else if (view !== "canada" && !this.querySelector(`.re-map[data-view="${view}"] a.map-link[data-fed="${fed}"]`)) this.#setView("canada");
      }

      if (source !== "hash") history.replaceState(null, "", `#r-${fed}`);

      let data: ResultsFile;
      try {
        data = await this.#load();
      } catch {
        this.#say("The riding results couldn't be loaded. Check your connection and try again, or use the table below the map.");
        return;
      }
      if (this.#selected !== fed) return; // A newer selection won.
      const r = this.#byFed.get(fed);
      if (!r) return;
      this.#render(r, data._meta.membersAsOf);

      if (source === "search" || source === "locate" || source === "table") {
        const stage = this.querySelector<HTMLElement>(".re-stage")!;
        const box = stage.getBoundingClientRect();
        if (box.top < 0 || box.bottom > window.innerHeight) stage.scrollIntoView({ block: "nearest", behavior: "smooth" });
      }
      if (source === "table") this.#panel.focus({ preventScroll: true });
    }

    #render(r: RidingResult, asOf: string) {
      const titleId = this.#panel.getAttribute("aria-labelledby")!;
      const ballots = r.candidates.reduce((sum, c) => sum + c.votes, 0);
      const fr = r.nameFr !== r.nameEn;
      const now = r.now;

      const nowNote =
        now &&
        h(
          "p",
          { class: "re-note" },
          now.kind === "vacant"
            ? `The seat is vacant as of ${date(asOf)}.`
            : now.kind === "new"
              ? h("span", { class: "re-note-person" }, portrait(now.photo, now.name, 36), h("span", {}, "Current MP: ", h("strong", {}, now.name), ` (${PARTY[now.party]}), since ${date(now.since)}.`))
              : h("span", {}, "Current MP: ", h("strong", {}, now.name), `, now sitting as ${now.party === "other" ? "an independent" : `a member of the ${PARTY[now.party]} caucus`}.`),
        );

      const details = h(
        "div",
        {},
        h("p", { class: "re-eyebrow" }, PROVINCE[r.province] ?? r.province),
        h("h3", { id: titleId, tabindex: "-1" }, r.nameEn),
        fr && h("p", { class: "re-sub" }, h("span", { class: "sr-only" }, "French name: "), h("span", { lang: "fr" }, r.nameFr)),
        r.renamed && h("p", { class: "re-sub" }, `Renamed ${r.renamed.en} after the election.`),
        h(
          "div",
          { class: "re-block" },
          h("p", { class: "re-label" }, "Elected in 2025"),
          h(
            "div",
            { class: "re-person" },
            portrait(r.winnerPhoto, r.winner, 52),
            h("div", {}, h("p", { class: "re-person-name" }, r.winner), h("p", { class: "re-mp" }, dot(r.party), PARTY[r.party] ?? "")),
          ),
          nowNote,
        ),
        h(
          "dl",
          { class: "re-block" },
          h("dt", {}, "Margin"),
          h("dd", {}, `${r.margin.toFixed(1)} pts (${num.format(r.marginVotes)} ${r.marginVotes === 1 ? "vote" : "votes"})`),
          h("dt", {}, "Turnout"),
          h("dd", {}, `${r.turnout.toFixed(1)}%`),
          h("dt", {}, "Electors"),
          h("dd", {}, num.format(r.electors)),
          h("dt", {}, "Valid votes"),
          h("dd", {}, num.format(ballots)),
        ),
        h(
          "div",
          { class: "re-block" },
          h("p", { class: "re-label", id: `${titleId}-votes` }, "Votes"),
          h(
            "ol",
            { class: "re-cands", "aria-labelledby": `${titleId}-votes` },
            ...r.candidates.map((c) =>
              h(
                "li",
                {},
                h(
                  "div",
                  { class: "re-cand-head" },
                  h("span", {}, h("span", { class: "re-cand-name" }, c.name, c.elected ? h("span", { class: "sr-only" }, " (elected)") : null), h("span", { class: "re-cand-party" }, c.label)),
                  h("span", { class: "re-cand-num" }, `${c.share.toFixed(1)}%`, h("span", { class: "re-cand-party" }, num.format(c.votes))),
                ),
                h("div", { class: "re-bar", "aria-hidden": "true" }, h("span", { style: `width:${c.share}%;--swatch:var(--tn-party-${c.party})` })),
              ),
            ),
          ),
        ),
        h("p", { class: "re-block" }, h("a", { href: `#r-${r.fed}`, class: "re-link", "data-to-table": "" }, "Show in the table")),
      );

      // The idle heading carries the panel's id until a riding is chosen.
      this.querySelector(".re-idle h3")?.removeAttribute("id");
      this.#details.replaceChildren(details);
      this.#details.hidden = false;
      this.#panel.dataset.state = "shown";
    }

    #fromHash() {
      const m = location.hash.match(/^#r-(\d+)$/);
      if (!m) return;
      const fed = Number(m[1]);
      if (!this.querySelector(`#r-${fed}`) || fed === this.#selected) return;
      const details = this.querySelector<HTMLDetailsElement>(".re-table-wrap");
      if (details && !details.open) {
        details.open = true;
        this.querySelector(`#r-${fed}`)?.scrollIntoView({ block: "center" });
      }
      void this.select(fed, "hash");
    }

    // --- Search -----------------------------------------------------------

    #setUpSearch() {
      const form = this.querySelector<HTMLFormElement>(".re-search")!;
      const input = form.querySelector("input")!;
      const rows = [...this.querySelectorAll<HTMLTableRowElement>("tbody tr")];
      // Names from the table, plus French and new names once the results load.
      const names = () => {
        const list: { fed: number; key: string }[] = rows.map((tr) => ({ fed: Number(tr.dataset.fed), key: fold(tr.cells[0]!.textContent!) }));
        for (const r of this.#byFed.values()) {
          list.push({ fed: r.fed, key: fold(r.nameFr) });
          if (r.renamed) list.push({ fed: r.fed, key: fold(r.renamed.en) }, { fed: r.fed, key: fold(r.renamed.fr) });
        }
        return list;
      };
      const find = (q: string, exactOnly: boolean) => {
        const k = fold(q);
        if (!k) return undefined;
        const list = names();
        return (
          list.find((n) => n.key === k) ??
          (exactOnly ? undefined : (list.find((n) => n.key.startsWith(k)) ?? list.find((n) => n.key.includes(k))))
        );
      };

      // Picking a suggestion from the list selects straight away.
      input.addEventListener("input", (e) => {
        if ((e as InputEvent).inputType && (e as InputEvent).inputType !== "insertReplacementText") return;
        const hit = find(input.value, true);
        if (hit) void this.select(hit.fed, "search");
      });
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const q = input.value.trim();
        if (!q) {
          this.#say("Type part of a riding's name, such as “Halifax” or “Laurentides”.");
          return;
        }
        await this.#load().catch(() => {});
        const hit = find(q, false);
        if (!hit) {
          this.#say(`No riding matches “${q}”. Try part of the name, or a nearby place.`);
          return;
        }
        const name = nameOf(hit.fed);
        this.#say(`Showing ${name}.`);
        void this.select(hit.fed, "search");
      });
    }

    // --- Find my riding ---------------------------------------------------

    #setUpLocate() {
      const button = this.querySelector<HTMLButtonElement>(".re-locate-button")!;
      if (!("geolocation" in navigator)) {
        button.disabled = true;
        button.title = "Your browser doesn't share its location";
        return;
      }
      button.addEventListener("click", async () => {
        if (button.getAttribute("aria-busy") === "true") return;
        button.setAttribute("aria-busy", "true");
        this.#say("Finding your location…");
        try {
          // Ask for the position and load the boundaries at the same time.
          const shapes = import("./locate").then(async (m) => {
            await m.loadShapes(this.dataset.topo!);
            return m;
          });
          const position = new Promise<GeolocationPosition>((resolve, reject) =>
            navigator.geolocation.getCurrentPosition(resolve, reject, { enableHighAccuracy: false, timeout: 15000, maximumAge: 600000 }),
          );
          let pos: GeolocationPosition;
          try {
            pos = await position;
          } catch (err) {
            const code = (err as GeolocationPositionError).code;
            this.#say(
              code === 1
                ? "Your browser didn't share your location. To use this, allow location for this site in your browser's settings, or search by name instead."
                : code === 3
                  ? "Finding your location took too long. Try again, or search by name instead."
                  : "Your location isn't available right now. Search by name instead.",
            );
            return;
          }
          let locate: typeof import("./locate");
          try {
            locate = await shapes;
          } catch {
            this.#say("The riding boundaries couldn't be loaded. Check your connection and try again.");
            return;
          }
          const { longitude, latitude, accuracy } = pos.coords;
          const match = locate.ridingAt(longitude, latitude);
          if (!match) {
            this.#say("Your location doesn't appear to be in Canada, so it isn't in a federal riding. You can still search by name.");
            return;
          }
          await this.#load().catch(() => {});
          const name = nameOf(match.fed);
          const fuzzy = accuracy > 1000 ? ` Your device placed you within about ${Math.round(accuracy / 1000)} km, so near a boundary it could be a neighbouring riding.` : "";
          this.#say(match.exact ? `You appear to be in ${name}.${fuzzy}` : `You appear to be just outside the mapped boundary. The nearest riding is ${name}.${fuzzy}`);
          void this.select(match.fed, "locate");
        } finally {
          button.removeAttribute("aria-busy");
        }
      });
    }

    // --- Table ------------------------------------------------------------

    #setUpTable() {
      const table = this.querySelector("table")!;
      const tbody = table.tBodies[0]!;
      const headers = [...table.querySelectorAll<HTMLTableCellElement>("thead th")];
      const collator = new Intl.Collator("en-CA", { sensitivity: "base", numeric: true });
      const icon = (dir: string) =>
        `<svg class="re-sort-icon" viewBox="0 0 12 12" aria-hidden="true"><path fill="currentColor" d="${
          dir === "ascending" ? "M6 3 10 8H2z" : dir === "descending" ? "M6 9 2 4h8z" : "M6 1.5 9 5H3zM6 10.5 3 7h6z"
        }"/></svg>`;

      for (const th of headers) {
        const key = th.dataset.sort!;
        const label = th.textContent!.trim();
        const button = document.createElement("button");
        button.type = "button";
        button.className = "re-sort";
        button.innerHTML = `${label}${icon("none")}`;
        th.replaceChildren(button);
        button.addEventListener("click", () => {
          const current = th.getAttribute("aria-sort");
          const numeric = th.hasAttribute("data-num");
          // Numbers sort high to low first; text A to Z.
          const dir = current === "ascending" ? "descending" : current === "descending" ? "ascending" : numeric ? "descending" : "ascending";
          for (const other of headers) {
            other.removeAttribute("aria-sort");
            other.querySelector(".re-sort-icon")!.outerHTML = icon("none");
          }
          th.setAttribute("aria-sort", dir);
          button.querySelector(".re-sort-icon")!.outerHTML = icon(dir);
          const sign = dir === "ascending" ? 1 : -1;
          const col = headers.indexOf(th);
          const value = (tr: HTMLTableRowElement) => tr.cells[col]!.dataset.v ?? tr.cells[col]!.textContent!.trim();
          const rows = [...tbody.rows];
          rows.sort((a, b) => {
            const c =
              key === "prov"
                ? Number(a.dataset.fed) - Number(b.dataset.fed)
                : numeric
                  ? parseFloat(value(a)) - parseFloat(value(b))
                  : collator.compare(value(a), value(b));
            return c * sign || Number(a.dataset.fed) - Number(b.dataset.fed);
          });
          tbody.append(...rows);
        });
      }

      // A riding's name in the table shows it on the map.
      tbody.addEventListener("click", (e) => {
        const link = (e.target as Element).closest<HTMLAnchorElement>("a.re-row-link");
        if (!link) return;
        e.preventDefault();
        void this.select(Number(link.closest("tr")!.dataset.fed), "table");
      });
      // And "Show in the table" opens the table at that row.
      this.#details.addEventListener("click", (e) => {
        const link = (e.target as Element).closest<HTMLAnchorElement>("a[data-to-table]");
        if (!link) return;
        e.preventDefault();
        const details = this.querySelector<HTMLDetailsElement>(".re-table-wrap")!;
        details.open = true;
        const row = this.querySelector<HTMLElement>(`#r-${this.#selected}`);
        row?.scrollIntoView({ block: "center", behavior: "smooth" });
        row?.querySelector("a")?.focus({ preventScroll: true });
      });
    }
  }

  customElements.define("tn-ridings-explorer", RidingsExplorer);
</script>
