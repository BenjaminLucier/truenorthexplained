---
/**
 * Map of historic (pre-1975) and modern treaty areas, from CIRNAC's open data
 * (src/data/geo/treaties.topo.json, built by `pnpm data:treaties`).
 *
 *   <tn-widget name="treaty-map"></tn-widget>
 *
 * Interaction follows the province-map widget: every treaty area is a link
 * (to its text or CIRNAC page), hover or focus shows a card with the name,
 * year and parties, and on touch screens the first tap shows the card and a
 * second tap follows the link. The era filter and the "outside historic
 * treaties" shading are native inputs that work through CSS alone. The year
 * slider and play button need JavaScript; without it every treaty shows.
 */
import { geoArea } from "d3-geo";
import ChartCard from "../../components/charts/ChartCard.astro";
import CanadaMap from "../../components/map/CanadaMap.astro";
import { outsideHistoricTreaties, provinceFeatures, treatyFeatures, type TreatyProps } from "../../components/map/geo";
import meta from "../../data/geo/treaties.topo.meta.json";

const id = "tm";
const treaties = treatyFeatures();
const outside = outsideHistoricTreaties();
const provinces = provinceFeatures();
const props = treaties.map((f) => f.properties as TreatyProps);
const historic = props.filter((p) => p.era === "historic");
const modern = props.filter((p) => p.era === "modern");
if (historic.length < 10 || modern.length < 20) throw new Error("treaty-map: the treaty data looks incomplete");

// Share of Canada's land inside a historic treaty area (spherical areas, so
// the projection doesn't distort it).
const landArea = provinces.reduce((a, f) => a + geoArea(f), 0);
const outsideArea = outside.reduce((a, f) => a + geoArea(f), 0);
const historicShare = Math.round(100 * (1 - outsideArea / landArea));
if (historicShare < 20 || historicShare > 80) throw new Error(`treaty-map: historic share looks wrong (${historicShare}%)`);

const years = [...new Set(props.map((p) => p.year))].sort((a, b) => a - b);
const first = years[0]!;
const last = years.at(-1)!;
const histLast = Math.max(...historic.map((p) => p.year));
const modFirst = Math.min(...modern.map((p) => p.year));

const fill = (p: TreatyProps) =>
  p.era === "modern" ? "var(--tn-data-treaty-modern)" : p.noSurrender ? "var(--tn-data-treaty-pf)" : "var(--tn-data-treaty-historic)";
const eraLabel = (p: TreatyProps) => (p.era === "modern" ? "Modern treaty" : "Historic treaty");
const yearText = (p: TreatyProps) => (p.yearNote ? `${p.years} (${p.yearNote})` : p.years);
const describe = (p: TreatyProps) =>
  `${eraLabel(p)}, ${yearText(p)}. ${p.kind}. Parties: ${p.parties}.${p.noSurrender ? " These treaties did not surrender land." : ""}`;

const OUTSIDE_TEXT =
  "Land not covered by any historic treaty. Some of it is now covered by modern treaties; much of it, including most of British Columbia, has no treaty at all.";
const sorted = [...props].sort((a, b) => a.year - b.year || a.name.localeCompare(b.name));
---

<tn-treaty-map class="tm not-prose block" data-first={first} data-last={last}>
  <ChartCard
    title="Treaty areas in Canada, 1725 to today"
    lede={`The ${historic.length} historic treaty areas, made between ${first} and ${histLast}, cover about ${historicShare}% of Canada's land: most of the Prairies, Ontario and the Maritimes. Since ${modFirst}, ${modern.length} modern treaties have covered much of the North and parts of British Columbia, where historic treaties mostly never reached.`}
    sources={[
      { label: "Crown–Indigenous Relations and Northern Affairs Canada, Historic treaties", url: meta.datasets[0]! },
      { label: "Modern treaties", url: meta.datasets[1]! },
      { label: "Statistics Canada, province boundaries (all Open Government Licence – Canada)", url: "https://open.canada.ca/data/en/dataset/ef70dc3b-1069-4037-9bce-61f47e628a1d" },
    ]}
    tableLabel="Show the data: every treaty on the map"
  >
    <div class="tm-controls">
      <fieldset class="tm-seg">
        <legend class="sr-only">Which treaties to show</legend>
        <label><input type="radio" name={`${id}-era`} value="all" checked /><span>All treaties</span></label>
        <label><input type="radio" name={`${id}-era`} value="historic" class="tm-era-historic" /><span>Historic</span></label>
        <label><input type="radio" name={`${id}-era`} value="modern" class="tm-era-modern" /><span>Modern</span></label>
      </fieldset>
      <label class="tm-check">
        <input type="checkbox" class="tm-show-outside" checked />
        <span>Shade land not covered by a historic treaty</span>
      </label>
    </div>

    <div class="tm-time" hidden>
      <button type="button" class="tm-play" aria-label="Play: show treaties in the order they were made">
        <svg viewBox="0 0 24 24" class="tm-icon-play" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
        <svg viewBox="0 0 24 24" class="tm-icon-pause" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
      </button>
      <label class="tm-slider">
        <span class="sr-only">Show treaties made up to</span>
        <input type="range" min="0" max={years.length - 1} step="1" value={years.length - 1} data-years={years.join(",")} />
      </label>
      <output class="tm-year" aria-live="polite">
        <span class="tm-year-n">{last}</span>
        <span class="tm-year-count text-muted">{props.length} treaties</span>
      </output>
    </div>

    <div class="tm-stage relative">
      <CanadaMap
        id={`${id}-map`}
        features={[...outside, ...treaties]}
        fitTo={provinces}
        context={provinces}
        contextClass="tm-land"
        overlay={provinces}
        overlayClass="tm-border"
        width={800}
        padding={6}
        precision={0}
        minArea={1.5}
        title="Map of historic and modern treaty areas in Canada"
        desc={`${historic.length} historic treaty areas and ${modern.length} modern treaties. Each area links to its treaty text or a government page; the same list, with the parties, is in the table after the map.`}
        item={(f) => {
          const p = f.properties as TreatyProps & { id: string };
          if (p.id === "outside") return { class: "tm-outside", data: { outside: "1" } };
          return {
            href: p.href,
            label: `${p.name}, ${p.years}`,
            fill: fill(p),
            class: p.era === "modern" ? "tm-modern" : "tm-historic",
            marker: "auto",
            data: {
              id: p.id,
              era: p.era,
              year: p.year,
              name: p.name,
              years: yearText(p),
              kind: p.kind,
              parties: p.parties,
              link: p.linkLabel,
              nosurrender: p.noSurrender ? "1" : undefined,
            },
            linkAttrs: { "aria-describedby": `${id}-d-${p.id}` },
          };
        }}
      >
        <defs>
          <pattern id={`${id}-hatch`} patternUnits="userSpaceOnUse" width="7" height="7" patternTransform="rotate(45)">
            <rect width="7" height="7" class="tm-hatch-bg" />
            <line x1="0" y1="0" x2="0" y2="7" class="tm-hatch-line" />
          </pattern>
        </defs>
        <path class="tm-focus" d="" aria-hidden="true" />
      </CanadaMap>

      <div class="tm-card" aria-hidden="true" data-state="idle">
        <p class="tm-hint">Tap a treaty area to see who made it and when.</p>
        <div class="tm-details">
          <p class="tm-era text-xs font-semibold tracking-wide uppercase"></p>
          <p class="tm-name mt-0.5 font-semibold text-primary"></p>
          <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-sm">
            <dt class="text-muted">Year</dt>
            <dd class="tm-years text-secondary"></dd>
            <dt class="text-muted">Parties</dt>
            <dd class="tm-parties text-secondary"></dd>
          </dl>
          <p class="tm-nosurrender mt-2 text-xs text-secondary">These treaties did not surrender land.</p>
          <a class="tm-go mt-3 inline-flex items-center gap-1 text-sm font-medium text-accent hover:text-accent-hover" href="#" tabindex="-1">
            <span class="tm-go-label"></span>
            <span aria-hidden="true">→</span>
          </a>
          <p class="tm-go-hint mt-2 text-xs text-muted">Click the area to open: <span class="tm-link-label"></span></p>
        </div>
        <div class="tm-outside-details">
          <p class="font-semibold text-primary">Not covered by a historic treaty</p>
          <p class="mt-1 text-sm text-secondary">{OUTSIDE_TEXT}</p>
        </div>
      </div>
    </div>

    <div class="tm-legend mt-4">
      <ul class="grid gap-x-6 gap-y-2 text-sm text-secondary sm:grid-cols-2">
        <li class="tm-legend-historic flex items-start gap-2.5">
          <span class="tm-swatch" style="--swatch:var(--tn-data-treaty-historic)" aria-hidden="true"></span>
          <span><span class="font-semibold text-primary">Historic treaty</span> (before 1975)</span>
        </li>
        <li class="tm-legend-historic flex items-start gap-2.5">
          <span class="tm-swatch" style="--swatch:var(--tn-data-treaty-pf)" aria-hidden="true"></span>
          <span><span class="font-semibold text-primary">Peace and Friendship Treaties</span>, which did not surrender land</span>
        </li>
        <li class="tm-legend-modern flex items-start gap-2.5">
          <span class="tm-swatch" style="--swatch:var(--tn-data-treaty-modern)" aria-hidden="true"></span>
          <span><span class="font-semibold text-primary">Modern treaty</span> (land claims agreement, since 1975)</span>
        </li>
        <li class="tm-legend-outside flex items-start gap-2.5">
          <svg class="tm-swatch" viewBox="0 0 16 16" aria-hidden="true"><rect width="16" height="16" fill={`url(#${id}-hatch)`} /></svg>
          <span><span class="font-semibold text-primary">Not covered by a historic treaty</span></span>
        </li>
      </ul>
      <p class="mt-3 text-xs text-muted">
        Where no treaty surrendered the land, it's often called unceded, but "not covered by a historic treaty" is a
        narrower idea. Modern treaties now cover much of the shaded North, and the Peace and Friendship Treaties of the
        Maritimes are historic treaties that did not surrender land. The map shows treaty boundaries, not who has rights
        where. Small treaty areas are circled.
      </p>
    </div>

    <div hidden>
      {props.map((p) => <p id={`${id}-d-${p.id}`}>{describe(p)}</p>)}
    </div>

    <Fragment slot="table">
      <table>
        <thead>
          <tr>
            <th scope="col">Treaty</th>
            <th scope="col">Year</th>
            <th scope="col">Type</th>
            <th scope="col">Parties</th>
          </tr>
        </thead>
        <tbody>
          {
            sorted.map((p) => (
              <tr>
                <th scope="row" class="font-normal">
                  <a href={p.href} class="text-accent underline underline-offset-2 hover:text-accent-hover">
                    {p.name}
                  </a>
                </th>
                <td>{yearText(p)}</td>
                <td>{p.era === "modern" ? "Modern" : "Historic"}</td>
                <td class="tm-parties-cell">{p.parties}</td>
              </tr>
            ))
          }
        </tbody>
        <caption>
          The map groups the 70 historic treaties CIRNAC recognizes into {historic.length} areas: the Upper Canada land
          surrenders alone are more than 30 agreements. Years are as CIRNAC's data records them; for several modern
          treaties that's the year the agreement took effect rather than the year it was signed. Treaty boundaries are
          simplified for this map.
        </caption>
      </table>
    </Fragment>
  </ChartCard>
</tn-treaty-map>

<style>
  /* Controls: a segmented era filter (native radios) and a checkbox. */
  .tm-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-bottom: 0.75rem;
  }
  .tm-seg {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.25rem;
    border: 1px solid var(--tn-border);
    border-radius: 9999px;
    background: var(--tn-surface-muted);
  }
  .tm-seg label {
    position: relative;
    cursor: pointer;
  }
  .tm-seg input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }
  .tm-seg span {
    display: block;
    border-radius: 9999px;
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--tn-text-secondary);
    transition: background-color 150ms, color 150ms;
  }
  .tm-seg input:checked + span {
    background: var(--tn-surface);
    color: var(--tn-text-primary);
    box-shadow: var(--shadow-card);
  }
  .tm-seg label:hover span {
    color: var(--tn-text-primary);
  }
  .tm-seg input:focus-visible + span {
    outline: 2px solid var(--tn-focus);
    outline-offset: 2px;
  }
  .tm-check {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--tn-text-secondary);
    cursor: pointer;
  }
  .tm-check input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--tn-accent);
  }

  /* Year slider and play button. */
  .tm-time:not([hidden]) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .tm-play {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid var(--tn-border-strong);
    background: var(--tn-surface);
    color: var(--tn-text-primary);
    cursor: pointer;
  }
  .tm-play:hover {
    background: var(--tn-surface-muted);
  }
  .tm-play svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }
  .tm-icon-pause,
  .tm[data-playing] .tm-icon-play {
    display: none;
  }
  .tm[data-playing] .tm-icon-pause {
    display: block;
  }
  .tm-slider {
    flex: 1;
    min-width: 0;
  }
  .tm-slider input {
    width: 100%;
    accent-color: var(--tn-accent);
  }
  .tm-year {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    min-width: 5.5rem;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }
  .tm-year-n {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--tn-text-primary);
  }
  .tm-year-count {
    font-size: 0.75rem;
  }

  /* The map. */
  /* Land under the treaty areas, seen where an area is filtered out or not yet made. */
  .tm :global(.tm-land) {
    fill: var(--tn-surface-muted);
    stroke: none;
  }
  .tm :global(.tm-border) {
    --map-overlay-stroke: var(--tn-text-muted);
    stroke-width: 0.6;
    stroke-opacity: 0.7;
  }
  .tm :global(.map-feature) {
    stroke: var(--tn-surface);
    stroke-width: 0.75;
    cursor: pointer;
    transition: opacity 250ms;
  }
  .tm :global(.tm-modern) {
    stroke: var(--tn-surface);
    stroke-width: 1;
  }
  .tm :global(.tm-outside) {
    fill: url(#tm-hatch);
    stroke: none;
    cursor: default;
  }
  .tm :global(.tm-hatch-bg) {
    fill: var(--tn-surface-muted);
  }
  .tm :global(.tm-hatch-line) {
    stroke: var(--tn-text-muted);
    stroke-width: 1.4;
    stroke-opacity: 0.55;
  }
  .tm :global(.map-link:hover .map-feature),
  .tm :global(.map-link.is-active .map-feature) {
    filter: brightness(0.92);
  }
  :global([data-theme="dark"]) .tm :global(.map-link:hover .map-feature),
  :global([data-theme="dark"]) .tm :global(.map-link.is-active .map-feature) {
    filter: brightness(1.2);
  }
  .tm :global(.canada-map) {
    filter: drop-shadow(0 0 0.5px var(--tn-text-muted));
  }
  .tm :global(.map-marker) {
    --map-marker-stroke: var(--tn-text-secondary);
  }
  .tm:not([data-ready]) :global(.map-link:focus-visible .map-feature) {
    stroke: var(--tn-focus);
    stroke-width: 2.5;
  }
  .tm-focus {
    fill: none;
    stroke: var(--tn-text-primary);
    stroke-width: 2;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }
  .tm[data-focus-visible] .tm-focus {
    stroke: var(--tn-focus);
    stroke-width: 3;
  }

  /* Era filter and the outside shading (CSS only). Hidden areas leave the tab order via visibility. */
  .tm:has(.tm-era-historic:checked) :global(.map-link[data-era="modern"]),
  .tm:has(.tm-era-modern:checked) :global(.map-link[data-era="historic"]),
  .tm :global(.map-link[data-future]) {
    visibility: hidden;
  }
  .tm:has(.tm-era-historic:checked) .tm-legend-modern,
  .tm:has(.tm-era-modern:checked) .tm-legend-historic {
    opacity: 0.4;
  }
  .tm:has(.tm-era-historic:checked) :global(.map-marker),
  .tm[data-scrubbing] :global(.map-marker) {
    display: none;
  }
  /* Unshaded, the outside area is plain land (the treaty areas and it cover all of Canada). */
  .tm:not(:has(.tm-show-outside:checked)) :global(.tm-outside),
  .tm[data-scrubbing] :global(.tm-outside) {
    fill: var(--tn-surface-muted);
  }
  .tm:not(:has(.tm-show-outside:checked)) .tm-legend-outside,
  .tm[data-scrubbing] .tm-legend-outside {
    opacity: 0.4;
  }

  .tm-swatch {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-top: 0.15rem;
    border-radius: 0.25rem;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--tn-text-primary) 15%, transparent);
    overflow: hidden;
  }

  .tm-parties-cell {
    white-space: normal !important;
    min-width: 16rem;
    text-align: start !important;
  }

  /* The card: docked under the map on touch screens and narrow layouts, floating where there's a mouse. */
  .tm-card {
    margin-top: 0.75rem;
    min-height: 8rem;
    border: 1px solid var(--tn-border);
    border-radius: var(--radius-card);
    background: var(--tn-surface);
    padding: 0.75rem 1rem;
  }
  .tm-hint {
    font-size: 0.875rem;
    color: var(--tn-text-muted);
  }
  .tm-era {
    color: var(--tn-text-muted);
  }
  .tm-card[data-state="idle"] .tm-details,
  .tm-card[data-state="idle"] .tm-outside-details,
  .tm-card:not([data-state="idle"]) .tm-hint,
  .tm-card[data-kind="outside"] .tm-details,
  .tm-card:not([data-kind="outside"]) .tm-outside-details,
  .tm-card:not([data-nosurrender]) .tm-nosurrender,
  .tm-go-hint {
    display: none;
  }
  .tm:not([data-ready]) .tm-card {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) and (min-width: 40rem) {
    .tm-card {
      position: absolute;
      z-index: 10;
      top: 0;
      left: 0;
      width: 19rem;
      min-height: 0;
      margin: 0;
      box-shadow: 0 4px 24px rgb(0 0 0 / 0.12);
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
    }
    .tm-card[data-state="shown"] {
      opacity: 1;
      visibility: visible;
    }
    .tm-hint,
    .tm-go {
      display: none !important;
    }
    .tm-card:not([data-kind="outside"]) .tm-go-hint {
      display: block;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .tm-card {
      transition:
        opacity 120ms ease-out,
        visibility 120ms;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tm :global(.map-feature),
    .tm-seg span {
      transition: none;
    }
  }
</style>

<script>
  const FLOATING = "(hover: hover) and (pointer: fine) and (min-width: 40rem)";

  class TreatyMap extends HTMLElement {
    #active: Element | null = null;
    #timer = 0;

    connectedCallback() {
      const stage = this.querySelector<HTMLElement>(".tm-stage")!;
      const card = this.querySelector<HTMLElement>(".tm-card")!;
      const focus = this.querySelector<SVGPathElement>(".tm-focus")!;
      const links = [...this.querySelectorAll<SVGAElement>("a.map-link")];
      const outside = this.querySelector<SVGPathElement>(".tm-outside");
      const floating = window.matchMedia(FLOATING);
      const go = card.querySelector<HTMLAnchorElement>(".tm-go")!;
      const set = (sel: string, text: string) => {
        const el = card.querySelector(sel);
        if (el) el.textContent = text;
      };

      const place = (el: Element, point?: { x: number; y: number }) => {
        const box = stage.getBoundingClientRect();
        let x: number;
        let y: number;
        if (point) {
          x = point.x - box.left + 16;
          y = point.y - box.top + 16;
        } else {
          const r = el.getBoundingClientRect();
          x = r.left - box.left + r.width / 2;
          y = r.top - box.top + r.height / 2;
        }
        const w = card.offsetWidth;
        const h = card.offsetHeight;
        if (x + w > box.width) x = Math.max(0, (point ? x - 32 : x) - w);
        if (y + h > box.height) y = Math.max(0, (point ? y - 32 : y) - h);
        card.style.transform = `translate(${Math.round(x)}px, ${Math.round(y)}px)`;
      };

      const show = (el: Element, point?: { x: number; y: number }) => {
        const isOutside = el === outside;
        if (this.#active !== el) {
          this.#active?.classList.remove("is-active");
          el.classList.add("is-active");
          this.#active = el;
          if (isOutside) {
            card.dataset.kind = "outside";
            focus.setAttribute("d", "");
          } else {
            const d = (el as SVGAElement).dataset;
            card.dataset.kind = d.era ?? "";
            if (d.nosurrender) card.dataset.nosurrender = "";
            else delete card.dataset.nosurrender;
            set(".tm-era", d.era === "modern" ? "Modern treaty" : "Historic treaty");
            set(".tm-name", d.name ?? "");
            set(".tm-years", d.years ?? "");
            set(".tm-parties", d.parties ?? "");
            set(".tm-go-label", d.link ?? "Read more");
            set(".tm-link-label", d.link ?? "");
            go.href = el.getAttribute("href") ?? "#";
            focus.setAttribute("d", el.querySelector("path")?.getAttribute("d") ?? "");
          }
        }
        card.dataset.state = "shown";
        card.setAttribute("aria-hidden", floating.matches ? "true" : "false");
        go.setAttribute("tabindex", floating.matches || isOutside ? "-1" : "0");
        if (floating.matches) place(el, point);
      };

      const hide = () => {
        if (!floating.matches) return; // The docked card keeps its last treaty.
        card.dataset.state = "hidden";
        this.#active?.classList.remove("is-active");
        this.#active = null;
        focus.setAttribute("d", "");
      };

      const hoverables: Element[] = [...links, ...(outside ? [outside] : [])];
      for (const el of hoverables) {
        el.addEventListener("pointerenter", (e) => {
          const pe = e as PointerEvent;
          if (pe.pointerType !== "mouse") return;
          if (el === outside && (this.dataset.scrubbing !== undefined || !this.#outsideOn())) return;
          show(el, { x: pe.clientX, y: pe.clientY });
        });
        el.addEventListener("pointermove", (e) => {
          const pe = e as PointerEvent;
          if (pe.pointerType === "mouse" && floating.matches && this.#active === el) place(el, { x: pe.clientX, y: pe.clientY });
        });
        el.addEventListener("pointerleave", (e) => {
          if ((e as PointerEvent).pointerType === "mouse") hide();
        });
      }
      for (const link of links) {
        link.addEventListener("focus", () => {
          if (link.matches(":focus-visible")) this.dataset.focusVisible = "";
          show(link);
        });
        link.addEventListener("blur", () => {
          delete this.dataset.focusVisible;
          hide();
        });
      }
      // Tapping the shaded land explains it.
      outside?.addEventListener("click", () => {
        if (this.dataset.scrubbing === undefined && this.#outsideOn()) show(outside);
      });

      // Touch: the first tap shows the card, a second tap on the same area follows the link.
      let touchTap = false;
      let sameAsBefore = false;
      this.addEventListener(
        "pointerdown",
        (e) => {
          touchTap = e.pointerType === "touch" || e.pointerType === "pen";
          const link = (e.target as Element).closest?.("a.map-link");
          sameAsBefore = Boolean(link) && link === this.#active && card.dataset.state === "shown";
        },
        { capture: true },
      );
      for (const link of links) {
        link.addEventListener("click", (e) => {
          if (touchTap && !sameAsBefore) {
            e.preventDefault();
            show(link);
          }
          touchTap = false;
        });
      }
      this.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && floating.matches && this.#active) hide();
      });
      floating.addEventListener("change", () => {
        card.style.transform = "";
        card.dataset.state = this.#active ? "shown" : "idle";
      });

      // ---- Year slider and play button
      const time = this.querySelector<HTMLElement>(".tm-time")!;
      const range = time.querySelector<HTMLInputElement>("input[type=range]")!;
      const play = time.querySelector<HTMLButtonElement>(".tm-play")!;
      const yearOut = time.querySelector<HTMLElement>(".tm-year-n")!;
      const countOut = time.querySelector<HTMLElement>(".tm-year-count")!;
      const years = (range.dataset.years ?? "").split(",").map(Number);
      const lastIndex = years.length - 1;

      const apply = () => {
        const i = Number(range.value);
        const year = years[i]!;
        let n = 0;
        for (const link of links) {
          const future = Number(link.dataset.year) > year;
          link.toggleAttribute("data-future", future);
          if (future && link === this.#active) hide();
          if (!future) n++;
        }
        yearOut.textContent = String(year);
        countOut.textContent = `${n} ${n === 1 ? "treaty" : "treaties"}`;
        range.setAttribute("aria-valuetext", `${year}: ${n} treaties`);
        this.toggleAttribute("data-scrubbing", i < lastIndex);
      };
      const stop = () => {
        window.clearInterval(this.#timer);
        this.#timer = 0;
        delete this.dataset.playing;
        play.setAttribute("aria-label", "Play: show treaties in the order they were made");
      };
      const start = () => {
        if (Number(range.value) >= lastIndex) range.value = "0";
        apply();
        this.dataset.playing = "";
        play.setAttribute("aria-label", "Pause");
        const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        this.#timer = window.setInterval(
          () => {
            const next = Number(range.value) + 1;
            if (next > lastIndex) return stop();
            range.value = String(next);
            apply();
          },
          reduced ? 1200 : 700,
        );
      };
      play.addEventListener("click", () => (this.#timer ? stop() : start()));
      range.addEventListener("input", () => {
        stop();
        apply();
      });
      time.hidden = false;
      apply();

      this.dataset.ready = "";
    }

    disconnectedCallback() {
      window.clearInterval(this.#timer);
    }

    #outsideOn() {
      return this.querySelector<HTMLInputElement>(".tm-show-outside")?.checked ?? false;
    }
  }

  customElements.define("tn-treaty-map", TreatyMap);
</script>
