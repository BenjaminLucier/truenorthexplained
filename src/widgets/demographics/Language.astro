---
/**
 * English, French and other mother tongues as a share of the population, by
 * census, for Canada, Quebec, New Brunswick and Ontario: four small line
 * charts on one 0–100% scale. Data: src/data/demographics/language.json.
 */
import ChartCard from "../../components/charts/ChartCard.astro";
import { linePath, scale } from "../../lib/charts";
import data from "../../data/demographics/language.json";
import ChartTips from "./ChartTips.astro";

const SERIES = [
  { key: "englishPct", label: "English", color: "var(--tn-data-cat-1)" },
  { key: "frenchPct", label: "French", color: "var(--tn-data-cat-2)" },
  { key: "otherPct", label: "Other languages", color: "var(--tn-data-cat-3)" },
] as const;
type Pt = (typeof data.series)[number]["points"][number];

const fmt = (v: number) => `${v.toFixed(1)}%`;
const people = new Intl.NumberFormat("en-CA");
const panels = data.series;
const byslug = (s: string) => panels.find((p) => p.slug === s)!;
const ca = byslug("canada").points;
const qc = byslug("quebec").points;
const nb = byslug("new-brunswick").points;
const on = byslug("ontario").points;
const [c0, cN] = [ca[0]!, ca.at(-1)!];
const [q0, qN] = [qc[0]!, qc.at(-1)!];
const [o0, oN] = [on[0]!, on.at(-1)!];
const nbN = nb.at(-1)!;
const years = ca.map((p) => p.year);
const first = years[0]!;
const last = years.at(-1)!;

const W = 320;
const H = 190;
const L = 30;
const R = 48;
const T = 10;
const B = 22;
const r1 = (n: number) => Math.round(n * 10) / 10;
const sx = scale(first, last, L, W - R);
const sy = scale(0, 100, H - B, T);
const x = (v: number) => r1(sx(v));
const y = (v: number) => r1(sy(v));
const step = r1((W - L - R) / (years.length - 1));
const val = (p: Pt, key: (typeof SERIES)[number]["key"]) => p[key];

/** End labels, nudged apart so they never overlap. */
function endLabels(p: Pt) {
  const items = SERIES.map((s) => ({ ...s, v: val(p, s.key), ly: y(val(p, s.key)) })).sort((a, b) => a.ly - b.ly);
  for (let i = 1; i < items.length; i++) if (items[i]!.ly - items[i - 1]!.ly < 12) items[i]!.ly = items[i - 1]!.ly + 12;
  return items;
}
const tipFor = (p: Pt) => SERIES.map((s) => `${s.label}: ${fmt(val(p, s.key))}`).join("|");
---

<ChartCard
  title={`Mother tongue, ${first} to ${last}`}
  lede={`French is the mother tongue of a shrinking share of Canadians: ${fmt(c0.frenchPct)} in ${first}, ${fmt(cN.frenchPct)} in ${last}. English has stayed between ${Math.floor(Math.min(...ca.map((p) => p.englishPct)))}% and ${Math.ceil(Math.max(...ca.map((p) => p.englishPct)))}%. The growth is in other languages, up from ${fmt(c0.otherPct)} to ${fmt(cN.otherPct)}. In Quebec, French slipped from ${fmt(q0.frenchPct)} to ${fmt(qN.frenchPct)}; in Ontario, other languages (${fmt(oN.otherPct)}) now far outnumber French (${fmt(oN.frenchPct)}).`}
  sources={[{ label: "Statistics Canada, table 15-10-0031-01: population by mother tongue, 1951 to 2021", url: data._meta.url }]}
  tableLabel="Show the data"
>
  <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-secondary">
    {
      SERIES.map((s) => (
        <li class="inline-flex items-center gap-2">
          <span class="h-0.5 w-5 rounded" style={`background:${s.color}`} aria-hidden="true" />
          {s.label}
        </li>
      ))
    }
  </ul>
  <p class="mt-1 text-xs text-muted">Share of each population whose mother tongue is that language, at each census.</p>

  <div class="mt-4 grid gap-x-6 gap-y-5 sm:grid-cols-2">
    {
      panels.map((panel) => {
        const pts = panel.points;
        const lastPt = pts.at(-1)!;
        return (
          <div>
            <p class="text-sm font-semibold text-primary">{panel.name}</p>
            <ChartTips label={`${panel.name}: mother tongue by census year`}>
              <svg viewBox={`0 0 ${W} ${H}`} data-tip-keys={SERIES.map((s) => s.color).join("|")} class="lg-svg block h-auto w-full overflow-visible" style="font-variant-numeric: tabular-nums">
                {[0, 25, 50, 75, 100].map((v) => (
                  <g>
                    <line x1={L} x2={W - R} y1={y(v)} y2={y(v)} class:list={[v === 0 ? "stroke-strong" : "stroke-subtle"]} stroke-width="1" />
                    <text x={L - 5} y={y(v) + 3.5} text-anchor="end" class="fill-muted text-[10px]">
                      {v}%
                    </text>
                  </g>
                ))}
                {[first, 1971, 1991, last].map((yr) => (
                  <text x={x(yr)} y={H - 6} text-anchor="middle" class="fill-muted text-[10px]">
                    {yr}
                  </text>
                ))}
                {SERIES.map((s) => (
                  <path
                    d={linePath(pts.map((p) => [x(p.year), y(val(p, s.key))]))}
                    fill="none"
                    stroke={s.color}
                    stroke-width="2"
                    stroke-linejoin="round"
                    stroke-linecap="round"
                  />
                ))}
                {endLabels(lastPt).map((s) => (
                  <g>
                    <circle cx={x(lastPt.year)} cy={y(s.v)} r="2.5" fill={s.color} />
                    <text x={W - R + 6} y={s.ly + 3.5} class="fill-secondary text-[10px] font-semibold">
                      {fmt(s.v)}
                    </text>
                  </g>
                ))}
                {pts.map((p) => (
                  <g
                    class="lg-yr"
                    data-tip-title={`${panel.name}, ${p.year}`}
                    data-tip={tipFor(p)}
                  >
                    <rect class="lg-hit" x={x(p.year) - step / 2} y={T} width={step} height={H - B - T} />
                    <line class="lg-guide" x1={x(p.year)} x2={x(p.year)} y1={T} y2={H - B} />
                    {SERIES.map((s) => (
                      <circle class="lg-dot" cx={x(p.year)} cy={y(val(p, s.key))} r="3.5" fill={s.color} />
                    ))}
                  </g>
                ))}
              </svg>
            </ChartTips>
          </div>
        );
      })
    }
  </div>
  <p class="mt-3 text-xs text-muted">
    New Brunswick, Canada's only officially bilingual province, has stayed about two-thirds English and one-third
    French ({fmt(nbN.englishPct)} and {fmt(nbN.frenchPct)} in {last}).
  </p>

  <Fragment slot="table">
    <table>
      <thead>
        <tr>
          <th scope="col">Census</th>
          {panels.map((p) => <th scope="col" colspan="3">{p.name}</th>)}
        </tr>
        <tr>
          <th scope="col"><span class="sr-only">Year</span></th>
          {panels.map(() => SERIES.map((s) => <th scope="col">{s.label === "Other languages" ? "Other" : s.label}</th>))}
        </tr>
      </thead>
      <tbody>
        {
          years.map((yr, i) => (
            <tr>
              <th scope="row" class="font-normal">{yr}</th>
              {panels.map((p) => SERIES.map((s) => <td>{fmt(val(p.points[i]!, s.key))}</td>))}
            </tr>
          ))
        }
      </tbody>
      <caption>
        Percent of the population by mother tongue (the first language learned at home and still understood). People who
        reported two or more mother tongues are shared out among them. Canada's population in {last}: {people.format(cN.total)}.
      </caption>
    </table>
  </Fragment>
</ChartCard>

<!--
  Global, not scoped: scoping would stamp an attribute on every mark. The class
  names are specific to this chart.
-->
<style is:global>
  .lg-hit {
    fill: transparent;
  }
  .lg-guide {
    stroke: var(--tn-text-muted);
    stroke-width: 1;
    stroke-dasharray: 2 2;
    opacity: 0;
  }
  .lg-dot {
    opacity: 0;
    stroke: var(--tn-surface);
    stroke-width: 1.5;
  }
  .lg-yr.is-active .lg-guide,
  .lg-yr.is-active .lg-dot {
    opacity: 1;
  }
  .lg-yr:focus-visible .lg-hit {
    stroke: var(--tn-focus);
    stroke-width: 1.5;
  }
</style>
