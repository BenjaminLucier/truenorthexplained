---
/**
 * First Nations, Métis and Inuit population: totals at the 2011, 2016 and 2021
 * censuses, and each province's and territory's share in 2021. Data:
 * src/data/demographics/indigenous.json.
 */
import ChartCard from "../../components/charts/ChartCard.astro";
import data from "../../data/demographics/indigenous.json";
import ChartTips from "./ChartTips.astro";

const GROUPS = [
  { key: "firstNations", label: "First Nations", color: "var(--tn-data-cat-1)" },
  { key: "metis", label: "Métis", color: "var(--tn-data-cat-2)" },
  { key: "inuit", label: "Inuit", color: "var(--tn-data-cat-3)" },
  { key: "rest", label: "More than one, or other", color: "var(--tn-data-cat-4)" },
] as const;
type Census = (typeof data.places)[number]["censuses"][number];
const part = (c: Census, key: (typeof GROUPS)[number]["key"]) => (key === "rest" ? c.multiple + c.otherIndigenous : c[key]);

const num = new Intl.NumberFormat("en-CA");
const millions = (n: number) => `${(n / 1e6).toFixed(2).replace(/0$/, "")} million`;
const canada = data.places.find((p) => p.slug === "canada")!;
const byYear = [...canada.censuses].sort((a, b) => a.year - b.year);
const c0 = byYear[0]!;
const cN = byYear.at(-1)!;
const growth = Math.round((100 * (cN.indigenous - c0.indigenous)) / c0.indigenous);
const maxTotal = Math.max(...byYear.map((c) => c.indigenous));
const places = data.places
  .filter((p) => p.slug !== "canada")
  .map((p) => ({ ...p, now: p.censuses.find((c) => c.year === cN.year)! }))
  .sort((a, b) => b.now.sharePct - a.now.sharePct);
const shareMax = Math.ceil(places[0]!.now.sharePct / 10) * 10;
const provincesOnly = places.filter((p) => !["yukon", "northwest-territories", "nunavut"].includes(p.slug));
const topProvince = provincesOnly[0]!;
// The note under the second chart names the top two; make sure they're still the territories it describes.
if (places[0]!.slug !== "nunavut" || places[1]!.slug !== "northwest-territories" || places[0]!.now.inuit < places[0]!.now.indigenous / 2) throw new Error("demographics: Indigenous share ranking changed; update the note");

const ages = data.ageGroups2021;
const sum = (k: "indigenous" | "nonIndigenous") => ages.reduce((n, a) => n + a[k], 0);
const under15 = (k: "indigenous" | "nonIndigenous") => (100 * ages.find((a) => a.age === "0 to 14")![k]) / sum(k);
const over65 = (k: "indigenous" | "nonIndigenous") => (100 * ages.find((a) => a.age === "65 and older")![k]) / sum(k);
const pc = (v: number) => `${v.toFixed(1)}%`;
const tip = (c: Census, g: (typeof GROUPS)[number], denom: number, of: string) =>
  `${num.format(part(c, g.key))} people|${pc((100 * part(c, g.key)) / denom)} of ${of}`;
---

<ChartCard
  title={`First Nations, Métis and Inuit, ${c0.year} to ${cN.year}`}
  lede={`In ${cN.year}, ${millions(cN.indigenous)} people in Canada identified as First Nations, Métis or Inuit: ${pc(cN.sharePct)} of the population, up from ${millions(c0.indigenous)} (${pc(c0.sharePct)}) in ${c0.year}, a rise of ${growth}%. The Indigenous population is young: ${pc(under15("indigenous"))} are under 15, against ${pc(under15("nonIndigenous"))} of non-Indigenous people.`}
  sources={[{ label: "Statistics Canada, table 98-10-0292-01: Indigenous identity population by gender and age (2011, 2016 and 2021)", url: data._meta.url }]}
  tableLabel="Show the data"
>
  <ul class="flex flex-wrap gap-x-5 gap-y-1.5 text-sm text-secondary">
    {
      GROUPS.map((g) => (
        <li class="inline-flex items-center gap-2">
          <span class="ig-swatch" style={`--swatch:${g.color}`} aria-hidden="true" />
          {g.label}
        </li>
      ))
    }
  </ul>

  <p class="mt-4 text-sm font-semibold text-primary">People who identified as Indigenous, by census</p>
  <ChartTips label="Indigenous population by census and group" class="mt-2">
    <div class="space-y-2">
      {
        byYear.map((c) => (
          <div class="grid grid-cols-[2.75rem_1fr] items-center gap-3">
            <span class="text-sm text-secondary tabular-nums">{c.year}</span>
            <div class="flex items-center gap-2">
              <div class="ig-bar" style={`--f:${(c.indigenous / maxTotal).toFixed(4)};--room:5.5rem`}>
                {GROUPS.map((g) => (
                  <span
                    class="ig-seg"
                    style={`--w:${((100 * part(c, g.key)) / c.indigenous).toFixed(2)}%;--c:${g.color}`}
                    data-tip-title={`${g.label}, ${c.year}`}
                    data-tip={tip(c, g, c.indigenous, "Indigenous people")}
                  />
                ))}
              </div>
              <span class="flex-none text-xs font-semibold text-primary tabular-nums">{millions(c.indigenous)}</span>
            </div>
          </div>
        ))
      }
    </div>
  </ChartTips>
  <p class="mt-2 text-xs text-muted">
    Bar length is the number of people. The {c0.year} figures come from the voluntary National Household Survey, so they
    compare less well. Growth comes from births and also from more people identifying as Indigenous over time.
  </p>

  <p class="mt-6 text-sm font-semibold text-primary">Share of each province's and territory's population, {cN.year}</p>
  <p class="text-xs text-muted">
    {`In ${places[0]!.name}, ${pc(places[0]!.now.sharePct)} of people are Indigenous, mostly Inuit; in the ${places[1]!.name}, ${pc(places[1]!.now.sharePct)}.`} Among the provinces, the share is highest in {topProvince.name} (
    {pc(topProvince.now.sharePct)}).
  </p>
  <ChartTips label={`Indigenous share of the population by province and territory, ${cN.year}`} class="mt-3">
    <div class="space-y-1.5">
      {
        places.map((p) => (
          <div class="grid grid-cols-[7.5rem_1fr] items-center gap-3 sm:grid-cols-[11rem_1fr]">
            <span class="truncate text-xs text-secondary sm:text-sm">{p.name}</span>
            <div class="flex items-center gap-2">
              <div class="ig-bar ig-bar-thin" style={`--f:${(p.now.sharePct / shareMax).toFixed(4)};--room:3.5rem`}>
                {GROUPS.map((g) => (
                  <span
                    class="ig-seg"
                    style={`--w:${((100 * part(p.now, g.key)) / p.now.indigenous).toFixed(2)}%;--c:${g.color}`}
                    data-tip-title={`${p.name}: ${g.label}`}
                    data-tip={tip(p.now, g, p.now.total, `the population of ${p.name}`)}
                  />
                ))}
              </div>
              <span class="flex-none text-xs font-medium text-primary tabular-nums">{pc(p.now.sharePct)}</span>
            </div>
          </div>
        ))
      }
    </div>
  </ChartTips>
  <p class="mt-2 text-xs text-muted">
    Canada as a whole: {pc(cN.sharePct)}. {pc(over65("indigenous"))} of Indigenous people were 65 or older in {cN.year},
    against {pc(over65("nonIndigenous"))} of non-Indigenous people.
  </p>

  <Fragment slot="table">
    <table>
      <thead>
        <tr>
          <th scope="col">Place</th>
          <th scope="col">Census</th>
          <th scope="col">Indigenous</th>
          <th scope="col">First Nations</th>
          <th scope="col">Métis</th>
          <th scope="col">Inuit</th>
          <th scope="col">More than one, or other</th>
          <th scope="col">Share of population</th>
        </tr>
      </thead>
      <tbody>
        {
          [canada, ...places].flatMap((p) =>
            [...p.censuses]
              .sort((a, b) => b.year - a.year)
              .map((c, i) => (
                <tr>
                  <th scope="row" class="font-normal">{i === 0 ? p.name : <span class="sr-only">{p.name}</span>}</th>
                  <td>{c.year}</td>
                  <td>{num.format(c.indigenous)}</td>
                  <td>{num.format(c.firstNations)}</td>
                  <td>{num.format(c.metis)}</td>
                  <td>{num.format(c.inuit)}</td>
                  <td>{num.format(c.multiple + c.otherIndigenous)}</td>
                  <td>{pc(c.sharePct)}</td>
                </tr>
              )),
          )
        }
      </tbody>
      <caption>
        Indigenous identity, from the census long-form questionnaire (25% sample); {c0.year} is from the National Household
        Survey. Counts are rounded by Statistics Canada. "More than one, or other" is people who reported more than one
        Indigenous identity, or an Indigenous response not included elsewhere.
      </caption>
    </table>
  </Fragment>
</ChartCard>

<!--
  Global, not scoped: scoping would stamp an attribute on every mark. The class
  names are specific to this chart.
-->
<style is:global>
  .ig-swatch {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 0.2rem;
    background: var(--swatch);
  }
  .ig-bar {
    display: flex;
    gap: 2px;
    /* A fraction of the row, leaving room for the value label after the bar. */
    width: calc((100% - var(--room)) * var(--f));
    height: 1.5rem;
  }
  .ig-bar-thin {
    height: 1rem;
  }
  .ig-seg {
    flex: 0 0 auto;
    width: calc(var(--w) - 2px);
    min-width: 2px;
    background: var(--c);
    border-radius: 2px;
  }
  .ig-seg:last-child {
    border-radius: 2px 4px 4px 2px;
  }
  .ig-seg.is-active {
    box-shadow:
      0 0 0 2px var(--tn-surface),
      0 0 0 3.5px var(--tn-text-primary);
  }
  .ig-seg:focus-visible {
    box-shadow:
      0 0 0 2px var(--tn-surface),
      0 0 0 4px var(--tn-focus);
  }
</style>
