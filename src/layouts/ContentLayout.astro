---
import BaseLayout from "./BaseLayout.astro";
import Icon from "../components/Icon.astro";
import ModuleIcon from "../components/ModuleIcon.astro";
import ProvinceHeader from "../components/ProvinceHeader.astro";
import QuizBlock from "../components/quiz/QuizBlock.astro";
import ModuleNav from "../components/ModuleNav.astro";
import WidthToggle from "../components/WidthToggle.astro";
import GlossaryPopovers from "../components/GlossaryPopovers.astro";
import { t } from "../i18n/en";
import { visualsForModule } from "../data/visuals";
import {
  breadcrumbsFor,
  href,
  moduleFor,
  moduleKey,
  moduleQuestionIds,
  questionsFor,
  sequenceFor,
  type Page,
} from "../lib/site";
import { eventsFor, relatedPages } from "../lib/semantic";

interface Props {
  page: Page;
  eyebrow?: string;
}

const { page, eyebrow } = Astro.props;
const crumbs = await breadcrumbsFor(page);
const mod = page.id.startsWith("learn/") ? await moduleFor(page.id) : undefined;
const questions = await questionsFor(page);
const sequence = await sequenceFor(page.id);
const index = sequence.findIndex((p) => p.id === page.id);
const prev = index > 0 ? sequence[index - 1] : undefined;
const next = index >= 0 ? sequence[index + 1] : undefined;
const modKey = mod ? moduleKey(mod.page.id) : undefined;
const modIds = mod ? await moduleQuestionIds(mod.page.id) : [];
const tryIt = mod ? visualsForModule(mod.page.id) : [];
const related = await relatedPages(page);
const onTimeline = eventsFor(page.id);
---

<BaseLayout title={page.data.title} description={page.data.summary}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6" data-module={modKey}>
    {mod && <ModuleNav variant="rail" mod={mod} current={page.id} questionIds={modIds} />}

    <div class="tn-col flex flex-wrap items-center justify-between gap-x-4 gap-y-3 pt-8">
    <nav aria-label={t.page.breadcrumb}>
      <ol class="flex flex-wrap items-center gap-1.5 text-sm text-muted">
        {
          crumbs.map((c, i) => (
            <li class="flex items-center gap-1.5">
              {i > 0 && <Icon name="ChevronRight" class="size-3.5 opacity-60" />}
              {c.href ? (
                <a href={c.href} class="hover:text-accent">
                  {c.label}
                </a>
              ) : (
                <span aria-current="page" class="text-secondary">
                  {c.label}
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="flex items-center gap-2">
      {mod && <ModuleNav variant="menu" mod={mod} current={page.id} questionIds={modIds} />}
      <WidthToggle />
    </div>
    </div>

    <header class="tn-col flow-root pt-6 pb-8">
      {eyebrow && (
        <p class="flex items-center gap-3 text-sm font-semibold tracking-wide text-module uppercase" data-pagefind-meta="section">
          {mod && <ModuleIcon name={mod.page.data.icon} size="sm" />}
          {eyebrow}
        </p>
      )}
      <h1 data-pagefind-meta="title" class="mt-2 text-4xl font-bold tracking-tight text-primary text-balance sm:text-5xl">{page.data.title}</h1>
      {page.data.summary && <p class="mt-4 text-lg text-secondary text-pretty">{page.data.summary}</p>}
      {page.data.type && <ProvinceHeader page={page} />}
      {
        tryIt.length > 0 && (
          <nav aria-labelledby="try-it" class="mt-6 flex flex-wrap items-center gap-2">
            <h2 id="try-it" class="me-1 flex items-center gap-1.5 text-xs font-semibold tracking-wide text-module uppercase">
              <Icon name="Sparkles" class="size-3.5" />
              {t.page.tryIt}
            </h2>
            {tryIt.map((v) => (
              <a
                href={v.href}
                class="inline-flex items-center gap-1.5 rounded-full border border-subtle bg-surface px-3 py-1 text-sm text-secondary transition-colors hover:border-accent hover:text-accent"
              >
                <Icon name={v.icon} class="size-3.5" />
                {v.title}
              </a>
            ))}
          </nav>
        )
      }
    </header>

    <div class="pb-8">
        <div class="tn-col">
          <article data-pagefind-body class="prose prose-tn max-w-none prose-headings:scroll-mt-24">
            <slot />
          </article>
        </div>
        <GlossaryPopovers page={page} />

        <div class="tn-col"><QuizBlock questions={questions} /></div>

        {
          onTimeline.length > 0 && (
            <nav aria-labelledby="on-timeline-heading" class="tn-col mt-16">
              <h2 id="on-timeline-heading" class="text-sm font-semibold tracking-wide text-muted uppercase">
                {t.page.onTimeline}
              </h2>
              <ul class="mt-4 flex flex-wrap gap-2">
                {onTimeline.map((e) => (
                  <li class="min-w-0">
                    <a
                      href={`/timeline#${e.slug}`}
                      class="inline-flex max-w-full items-baseline gap-2 rounded-full border border-subtle px-3 py-1 text-sm text-secondary transition-colors hover:border-accent hover:text-accent"
                    >
                      <span class="font-semibold text-primary tabular-nums">{e.year}</span>
                      <span class="truncate">{e.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        {
          related.length > 0 && (
            <nav aria-labelledby="related-heading" class="tn-col mt-16">
              <h2 id="related-heading" class="text-sm font-semibold tracking-wide text-muted uppercase">
                {t.page.related}
              </h2>
              <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                {related.map((r) => (
                  <li class="min-w-0">
                    <a
                      href={href(r.page.id)}
                      class="group block h-full rounded-card border border-subtle p-4 transition-colors hover:border-accent"
                    >
                      <span class="block font-semibold text-primary group-hover:text-accent">{r.page.data.title}</span>
                      {r.page.data.summary && <span class="mt-1 line-clamp-2 text-sm text-secondary">{r.page.data.summary}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        {
          (prev || next) && (
            <nav aria-label="Pagination" class="tn-col mt-16 grid gap-4 border-t border-subtle pt-8 sm:grid-cols-2">
              {prev ? (
                <a
                  href={href(prev.id)}
                  class="group rounded-card border border-subtle p-4 transition-colors hover:border-accent"
                >
                  <span class="flex items-center gap-1 text-xs text-muted">
                    <Icon name="ArrowLeft" class="size-3.5" />
                    {t.page.previous}
                  </span>
                  <span class="mt-1 block font-semibold text-primary group-hover:text-accent">{prev.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a
                  href={href(next.id)}
                  class="group rounded-card border border-subtle p-4 text-end transition-colors hover:border-accent"
                >
                  <span class="flex items-center justify-end gap-1 text-xs text-muted">
                    {t.page.next}
                    <Icon name="ArrowRight" class="size-3.5" />
                  </span>
                  <span class="mt-1 block font-semibold text-primary group-hover:text-accent">{next.data.title}</span>
                </a>
              )}
            </nav>
          )
        }
    </div>
  </div>
</BaseLayout>
