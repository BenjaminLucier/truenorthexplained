---
import ContentLayout from "../layouts/ContentLayout.astro";
import ProvinceCards from "../components/ProvinceCards.astro";
import Widget from "../components/Widget.astro";
import { splitWidgets } from "../lib/widgets";
import { allPages, moduleFor, type Page } from "../lib/site";
import { t } from "../i18n/en";

export async function getStaticPaths() {
  const pages = await allPages();
  return pages.filter((p) => p.id !== "home").map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props as { page: Page };
const chunks = splitWidgets(page.rendered?.html ?? "");
// Anchor each widget by name (#bill-steps); repeats get a suffix (#timeline-2).
const seen = new Map<string, number>();
const anchorFor = (name: string) => {
  const n = (seen.get(name) ?? 0) + 1;
  seen.set(name, n);
  return n === 1 ? name : `${name}-${n}`;
};

let eyebrow: string | undefined;
if (page.id.startsWith("learn/")) {
  const mod = await moduleFor(page.id);
  if (mod) {
    eyebrow =
      mod.page.id === page.id
        ? `${t.page.module} ${mod.page.data.order}`
        : `${t.page.deepDives} · ${mod.page.data.title}`;
  }
} else if (page.data.type) {
  eyebrow = page.data.type === "province" ? "Province" : "Territory";
}
---

<ContentLayout page={page} eyebrow={eyebrow}>
  {page.id === "provinces" && <ProvinceCards />}
  {chunks.map((c) => (c.kind === "html" ? <Fragment set:html={c.html} /> : <Widget name={c.name} props={c.props} anchor={anchorFor(c.name)} />))}
</ContentLayout>
