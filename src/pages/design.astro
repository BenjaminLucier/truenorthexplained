---
/**
 * Design system reference. Not linked from the site; excluded from search engines.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import MapleLeaf from "../components/MapleLeaf.astro";
import QuizSummary from "../components/quiz/QuizSummary.astro";

const colors = [
  { group: "Surfaces", tokens: ["bg", "surface", "surface-muted", "surface-sunken"] },
  { group: "Text", tokens: ["primary", "secondary", "muted"] },
  { group: "Borders", tokens: ["subtle", "strong"] },
  { group: "Accent", tokens: ["accent", "accent-hover", "accent-soft", "accent-contrast"] },
  { group: "Feedback", tokens: ["success", "success-soft", "danger", "danger-soft", "focus"] },
];
// Static class map so Tailwind can see every class at build time.
const swatch: Record<string, string> = {
  bg: "bg-bg", surface: "bg-surface", "surface-muted": "bg-surface-muted", "surface-sunken": "bg-surface-sunken",
  primary: "bg-primary", secondary: "bg-secondary", muted: "bg-muted", subtle: "bg-subtle", strong: "bg-strong",
  accent: "bg-accent", "accent-hover": "bg-accent-hover", "accent-soft": "bg-accent-soft",
  "accent-contrast": "bg-accent-contrast", success: "bg-success", "success-soft": "bg-success-soft",
  danger: "bg-danger", "danger-soft": "bg-danger-soft", focus: "bg-focus",
};
const type = [
  { cls: "text-5xl font-bold tracking-tight", label: "Display · text-5xl bold" },
  { cls: "text-4xl font-bold tracking-tight", label: "Page title · text-4xl bold" },
  { cls: "text-2xl font-bold tracking-tight", label: "Section · text-2xl bold" },
  { cls: "text-lg text-secondary", label: "Lede · text-lg secondary" },
  { cls: "text-base text-secondary", label: "Body · text-base secondary" },
  { cls: "text-sm text-muted", label: "Small · text-sm muted" },
  { cls: "text-xs font-semibold tracking-wide text-muted uppercase", label: "Label · text-xs uppercase" },
];
---

<BaseLayout title="Design system">
  <meta name="robots" content="noindex" slot="head" />
  <div class="mx-auto max-w-6xl space-y-16 px-4 py-12 sm:px-6">
    <header>
      <p class="text-sm font-semibold tracking-wide text-accent uppercase">Internal</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight text-primary">Design system</h1>
      <p class="mt-3 max-w-2xl text-secondary">
        Semantic tokens only: every colour below is a CSS variable with light and dark values. Use the toggle in the
        header to compare themes.
      </p>
    </header>

    <section>
      <h2 class="text-2xl font-bold tracking-tight text-primary">Colour tokens</h2>
      <div class="mt-6 space-y-8">
        {
          colors.map((g) => (
            <div>
              <h3 class="text-xs font-semibold tracking-wide text-muted uppercase">{g.group}</h3>
              <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
                {g.tokens.map((tok) => (
                  <li class="overflow-hidden rounded-card border border-subtle bg-surface">
                    <div class:list={["h-16 border-b border-subtle", swatch[tok]]} />
                    <code class="block px-3 py-2 text-xs text-secondary">{tok}</code>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold tracking-tight text-primary">Typography · Inter</h2>
      <ul class="mt-6 space-y-5">
        {
          type.map((ty) => (
            <li class="border-b border-subtle pb-4">
              <p class={ty.cls}>The True North, strong and free</p>
              <code class="mt-1 block text-xs text-muted">{ty.label}</code>
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="text-2xl font-bold tracking-tight text-primary">Buttons and links</h2>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a href="#" class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 font-semibold text-accent-contrast hover:bg-accent-hover">
          Primary <Icon name="ArrowRight" class="size-4" />
        </a>
        <a href="#" class="inline-flex rounded-full border border-strong bg-surface px-6 py-3 font-semibold text-primary hover:border-accent hover:text-accent">
          Secondary
        </a>
        <a href="#" class="font-medium text-accent underline underline-offset-3 hover:text-accent-hover">Text link</a>
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold tracking-tight text-primary">Cards and brand</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        <div class="rounded-card border border-subtle bg-surface p-6 shadow-card">
          <MapleLeaf class="size-8 text-accent" />
          <p class="mt-3 font-semibold text-primary">Card</p>
          <p class="mt-1 text-sm text-secondary">rounded-card · border-subtle · bg-surface · shadow-card</p>
        </div>
        <div class="rounded-card bg-surface-muted p-6">
          <p class="font-semibold text-primary">Muted panel</p>
          <p class="mt-1 text-sm text-secondary">For asides and footers.</p>
        </div>
        <div class="rounded-card bg-accent p-6 text-accent-contrast">
          <MapleLeaf class="size-8" />
          <p class="mt-3 font-semibold">Accent panel</p>
        </div>
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold tracking-tight text-primary">Progress</h2>
      <div class="mt-6 max-w-sm">
        <QuizSummary ids={["big-picture-head-of-state", "big-picture-vote-for-pm"]} label="Example summary" />
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold tracking-tight text-primary">Prose</h2>
      <article class="prose prose-tn mt-6 max-w-3xl">
        <h2>A section heading</h2>
        <p>
          Body text with <strong>bold key terms</strong>, an <a href="/glossary">internal link</a>, and an
          <a href="https://laws-lois.justice.gc.ca/eng/const/" data-external>external source</a>.
        </p>
        <blockquote><p><strong>As of 2026:</strong> The House of Commons has 343 seats.</p></blockquote>
        <ul><li>A list item</li><li>Another list item</li></ul>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Role</th><th>Who</th></tr></thead>
            <tbody><tr><td>Head of state</td><td>The King</td></tr><tr><td>Head of government</td><td>Prime Minister</td></tr></tbody>
          </table>
        </div>
      </article>
    </section>
  </div>
</BaseLayout>
