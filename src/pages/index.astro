---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import MapleLeaf from "../components/MapleLeaf.astro";
import ModuleIcon from "../components/ModuleIcon.astro";
import ProgressRing from "../components/quiz/ProgressRing.astro";
import ProvinceMap from "../widgets/province-map/index.astro";
import { getPage, href, moduleKey, moduleQuestionIds, modules, provinces } from "../lib/site";
import { t } from "../i18n/en";
import { VISUALS } from "../data/visuals";

const home = await getPage("home");
const hero = home.data.hero!;
const ideas = home.data.ideas ?? [];
const mods = await modules();
const featured = VISUALS.filter((v) => v.featured);
const quizIds = new Map(await Promise.all(mods.map(async (m) => [m.page.id, await moduleQuestionIds(m.page.id)] as const)));
const modById = new Map(mods.map((m) => [m.page.id, m.page]));

// Hero: a few of the things the site covers, each linking to its module.
const learnChips = [
  { id: "learn/crown", label: "What the King actually does" },
  { id: "learn/parliament", label: "How Parliament works" },
  { id: "learn/elections", label: "How your vote counts" },
  { id: "learn/federalism", label: "Who does what" },
  { id: "learn/charter", label: "Your Charter rights" },
  { id: "learn/indigenous", label: "Treaties and rights" },
].map((c) => ({ ...c, page: modById.get(c.id)! }));

// "Canada by the numbers". Seat counts can change: see the "as of" note below the strip.
const numbers = [
  { value: "343", label: "MPs in the House of Commons", href: "/learn/parliament" },
  { value: "105", label: "senators", href: "/learn/parliament/senate" },
  { value: "10 + 3", label: "provinces and territories", href: "/provinces" },
  { value: "1867", label: "Confederation", href: "/learn/constitution/constitution-act-1867" },
  { value: "1982", label: "The Constitution comes home, with the Charter", href: "/learn/constitution/patriation-1982" },
  { value: "2", label: "official languages", href: "/glossary#official-languages" },
  { value: "9", label: "Supreme Court judges", href: "/learn/law/supreme-court" },
];

// "Start here": a short reading path through the core modules.
const path = ["learn/big-picture", "learn/parliament", "learn/elections", "learn/charter"].map((id) => modById.get(id)!);
const provs = await provinces();
const reference = [
  { href: "/glossary", label: t.nav.glossary, icon: "BookA" as const, text: "Every term, in plain words" },
  { href: "/timeline", label: t.footer.timeline, icon: "History" as const, text: "Key moments, from 1763 to today" },
  { href: "/myths", label: t.footer.myths, icon: "Lightbulb" as const, text: "Common misunderstandings, corrected" },
  { href: "/sources", label: t.footer.sources, icon: "Library" as const, text: "The official documents behind it all" },
  { href: "/prime-ministers", label: t.footer.primeMinisters, icon: "Users" as const, text: "Every one since 1867, on one timeline" },
  { href: "/governors-general", label: t.footer.governorsGeneral, icon: "Crown" as const, text: "The Crown's people since Confederation" },
  { href: "/demographics", label: t.footer.demographics, icon: "ChartLine" as const, text: "How the population has grown and changed" },
];
---

<BaseLayout title={t.siteName} description={home.data.summary}>
  {/* Hero */}
  <section class="relative overflow-hidden border-b border-subtle">
    <div class="hero-pattern pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      {/* Decorative leaf, anchored to the content column so it sits beside the text at any width. */}
      <MapleLeaf
        class="pointer-events-none absolute end-0 top-1/2 hidden size-80 -translate-y-1/2 text-accent opacity-[0.08] md:block lg:end-6 lg:size-96"
      />
      <p class="inline-flex items-center gap-2 rounded-full border border-subtle bg-surface px-3 py-1 text-sm text-secondary">
        <MapleLeaf class="size-3.5 text-accent" />
        {t.tagline}
      </p>
      <h1 class="mt-6 max-w-3xl text-5xl font-bold tracking-tight text-primary text-balance sm:text-6xl">
        {hero.title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-secondary text-pretty sm:text-xl">{hero.lede}</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href={hero.primary.href}
          class="inline-flex items-center gap-2 rounded-full bg-accent px-6 py-3 font-semibold text-accent-contrast shadow-card transition-colors hover:bg-accent-hover"
        >
          {hero.primary.label}
          <Icon name="ArrowRight" class="size-4" />
        </a>
        <a
          href={hero.secondary.href}
          class="inline-flex items-center gap-2 rounded-full border border-strong bg-surface px-6 py-3 font-semibold text-primary transition-colors hover:border-accent hover:text-accent"
        >
          {hero.secondary.label}
        </a>
      </div>
      <div class="mt-12 max-w-3xl">
        <p class="text-xs font-semibold tracking-wide text-muted uppercase">You'll learn</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            learnChips.map((c) => (
              <li data-module={moduleKey(c.id)}>
                <a
                  href={href(c.id)}
                  class="inline-flex items-center gap-2 rounded-full border border-subtle bg-surface py-1 ps-1 pe-3.5 text-sm text-secondary shadow-card transition-colors hover:border-module hover:text-primary"
                >
                  <ModuleIcon name={c.page.data.icon} size="sm" class="!size-7 !rounded-full" />
                  {c.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* Canada by the numbers */}
  <section aria-labelledby="numbers-heading" class="border-b border-subtle bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <h2 id="numbers-heading" class="text-sm font-semibold tracking-wide text-accent uppercase">Canada by the numbers</h2>
      <ul class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-card border border-subtle bg-subtle sm:grid-cols-4 lg:grid-cols-7">
        {
          numbers.map((n, i) => (
            <li class:list={["bg-surface", i === numbers.length - 1 && "col-span-2 sm:col-span-1"]}>
              <a href={n.href} class="group flex h-full flex-col gap-1 p-4 transition-colors hover:bg-surface-muted">
                <span class="text-3xl font-bold tracking-tight text-primary tabular-nums group-hover:text-accent">
                  {n.value}
                </span>
                <span class="text-sm text-muted text-pretty">{n.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-xs text-muted">Seat counts as of 2026.</p>
    </div>
  </section>

  {/* One-sentence answer */}
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <h2 class="text-sm font-semibold tracking-wide text-accent uppercase">The one-sentence answer</h2>
    <p class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-primary text-balance">
      Canada is a <span class="text-accent">federal parliamentary democracy</span> and a{" "}
      <span class="text-accent">constitutional monarchy</span>.
    </p>
    <ul class="mt-10 grid gap-4 md:grid-cols-3">
      {
        ideas.map((idea) => (
          <li>
            <a
              href={idea.href}
              class="group flex h-full flex-col rounded-card border border-subtle bg-surface p-6 shadow-card transition-colors hover:border-accent"
            >
              <span class="text-lg font-semibold text-primary group-hover:text-accent">{idea.title}</span>
              <span class="mt-2 flex-1 text-secondary">{idea.text}</span>
              <span class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-accent">
                {t.page.readMore}
                <Icon name="ArrowRight" class="size-4 transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* Start here */}
  <section aria-labelledby="start-heading" class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <div class="rounded-card border border-subtle bg-surface p-6 shadow-card sm:p-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="start-heading" class="text-2xl font-bold tracking-tight text-primary">Start here</h2>
          <p class="mt-1 text-secondary">New to all this? Read these four modules in order. Each takes a few minutes.</p>
        </div>
      </div>
      <ol class="start-path mt-8 grid gap-4 md:grid-cols-4 md:gap-6">
        {
          path.map((p, i) => (
            <li data-module={moduleKey(p.id)} class="relative">
              <a href={href(p.id)} class="group flex h-full gap-4 md:flex-col md:gap-3">
                <span class="relative z-10 flex shrink-0 flex-col items-center">
                  <ModuleIcon name={p.data.icon} size="md" class="ring-4 ring-surface" />
                </span>
                <span class="min-w-0">
                  <span class="block text-xs font-semibold text-module tabular-nums">Step {i + 1}</span>
                  <span class="mt-0.5 block font-semibold text-primary group-hover:text-module">{p.data.title}</span>
                  <span class="mt-1 block text-sm text-secondary">{p.data.summary}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Modules */}
  <section class="border-y border-subtle bg-surface-muted">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl font-bold tracking-tight text-primary">The modules</h2>
          <p class="mt-2 text-secondary">Ten short modules. Each one stands on its own.</p>
        </div>
        <a href="/learn" class="inline-flex items-center gap-1 font-medium text-accent hover:text-accent-hover">
          All modules <Icon name="ArrowRight" class="size-4" />
        </a>
      </div>
      <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          mods.map(({ page, deepDives }) => (
            <li data-module={moduleKey(page.id)}>
              <a
                href={href(page.id)}
                class="group relative flex h-full flex-col overflow-hidden rounded-card border border-subtle bg-surface p-5 transition-colors hover:border-module"
              >
                <span class="absolute inset-x-0 top-0 h-1 bg-module opacity-70" aria-hidden="true" />
                <span class="flex items-center justify-between">
                  <ModuleIcon name={page.data.icon} />
                  <span class="text-xs font-semibold text-muted tabular-nums">
                    {String(page.data.order).padStart(2, "0")}
                  </span>
                </span>
                <span class="mt-4 font-semibold text-primary group-hover:text-module">{page.data.title}</span>
                <span class="mt-2 flex-1 text-sm text-secondary">{page.data.summary}</span>
                <span class="mt-4 flex items-center justify-between gap-3">
                  <span class="text-xs text-muted">{deepDives.length > 0 && `${deepDives.length} deep dives`}</span>
                  <ProgressRing ids={quizIds.get(page.id) ?? []} />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Provinces + quizzes */}
  {/* Maps and interactives */}
  <section aria-labelledby="visuals-heading" class="mx-auto max-w-6xl px-4 pt-20 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="visuals-heading" class="text-3xl font-bold tracking-tight text-primary">Maps, charts and interactives</h2>
        <p class="mt-2 text-secondary">See it instead of reading it: click through, sort, zoom and explore.</p>
      </div>
      <a href="/explore" class="inline-flex items-center gap-1 font-medium text-accent hover:text-accent-hover">
        See all {VISUALS.length} <Icon name="ArrowRight" class="size-4" />
      </a>
    </div>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((v) => (
          <li>
            <a
              href={v.href}
              class="group flex h-full gap-4 rounded-card border border-subtle bg-surface p-5 shadow-card transition-colors hover:border-accent"
            >
              <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent">
                <Icon name={v.icon} class="size-5.5" />
              </span>
              <span>
                <span class="block font-semibold text-primary group-hover:text-accent">{v.title}</span>
                <span class="mt-1 block text-sm text-secondary">{v.text}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-4 py-20 sm:px-6 lg:grid-cols-2">
    <div class="rounded-card border border-subtle bg-surface p-8 shadow-card">
      <Icon name="Map" class="size-8 text-accent" />
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-primary">Provinces and territories</h2>
      <p class="mt-2 text-secondary">All 13, and what makes each one different.</p>
      <div class="mt-6">
        <ProvinceMap compact />
      </div>
      <ul class="mt-6 flex flex-wrap gap-2">
        {
          provs.map((p) => (
            <li>
              <a
                href={href(p.id)}
                class="inline-block rounded-full border border-subtle px-3 py-1 text-sm text-secondary hover:border-accent hover:text-accent"
              >
                {p.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="rounded-card border border-subtle bg-surface p-8 shadow-card">
      <Icon name="ListChecks" class="size-8 text-accent" />
      <h2 class="mt-4 text-2xl font-bold tracking-tight text-primary">Test yourself</h2>
      <p class="mt-2 text-secondary">
        Every page ends with a short quiz. Or quiz yourself on a topic, a province, or everything. Your progress stays
        in your browser.
      </p>
      <a
        href="/quizzes"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 font-semibold text-accent-contrast hover:bg-accent-hover"
      >
        Go to quizzes <Icon name="ArrowRight" class="size-4" />
      </a>
    </div>
  </section>

  {/* Reference */}
  <section class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-sm font-semibold tracking-wide text-muted uppercase">{t.footer.reference}</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        reference.map((r) => (
          <li>
            <a href={r.href} class="group flex gap-3 rounded-card p-3 hover:bg-surface-muted">
              <Icon name={r.icon} class="mt-0.5 size-5 text-accent" />
              <span>
                <span class="block font-semibold text-primary group-hover:text-accent">{r.label}</span>
                <span class="block text-sm text-muted">{r.text}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  /* A faint dot grid behind the hero, fading out towards the edges. */
  .hero-pattern {
    background-image: radial-gradient(var(--tn-border-strong) 1px, transparent 1.5px);
    background-size: 22px 22px;
    opacity: 0.55;
    mask-image: radial-gradient(ellipse 80% 70% at 75% 45%, black 10%, transparent 75%);
  }
  /* Connecting line between the steps of the reading path. */
  .start-path li:not(:last-child)::before {
    content: "";
    position: absolute;
    inset-inline-start: calc(1.375rem - 1px);
    top: 2.75rem;
    bottom: -1rem;
    width: 2px;
    background: var(--tn-border);
  }
  @media (min-width: 48rem) {
    .start-path li:not(:last-child)::before {
      inset-inline-start: 2.75rem;
      inset-inline-end: -1.5rem;
      top: calc(1.375rem - 1px);
      bottom: auto;
      width: auto;
      height: 2px;
    }
  }
</style>
