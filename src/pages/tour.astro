---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { href, modules, tldrHtml } from "../lib/site";
import { t } from "../i18n/en";

const mods = await modules();
---

<BaseLayout title={t.nav.tour} description="Every module in one short paragraph: how Canada works in ten minutes.">
  <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="text-sm font-semibold tracking-wide text-accent uppercase">{t.nav.tour}</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight text-primary text-balance sm:text-5xl">
      How Canada works, in ten minutes
    </h1>
    <p class="mt-4 text-lg text-secondary">
      One short paragraph from each module, in order. Follow any link to go deeper.
    </p>

    <ol class="mt-12 space-y-12">
      {
        mods.map(({ page }) => (
          <li class="relative border-s-2 border-subtle ps-6">
            <span class="absolute -start-[9px] top-1.5 size-4 rounded-full border-2 border-accent bg-bg" aria-hidden="true" />
            <p class="text-xs font-semibold text-muted tabular-nums">
              {t.page.module} {page.data.order}
            </p>
            <h2 class="mt-1 text-2xl font-bold tracking-tight text-primary">{page.data.title}</h2>
            <div class="prose prose-tn mt-3 max-w-none" set:html={tldrHtml(page)} />
            <a
              href={href(page.id)}
              class="mt-3 inline-flex items-center gap-1 font-medium text-accent hover:text-accent-hover"
            >
              {t.page.readMore}: {page.data.title}
              <Icon name="ArrowRight" class="size-4" />
            </a>
          </li>
        ))
      }
    </ol>

    <div class="mt-16 rounded-card border border-subtle bg-surface-muted p-6">
      <p class="font-semibold text-primary">That's the whole picture.</p>
      <p class="mt-1 text-secondary">See how much stuck, or explore the provinces and territories.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/quizzes" class="rounded-full bg-accent px-5 py-2 font-semibold text-accent-contrast hover:bg-accent-hover">
          Quiz yourself
        </a>
        <a href="/provinces" class="rounded-full border border-strong px-5 py-2 font-semibold text-primary hover:border-accent">
          {t.nav.provinces}
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
