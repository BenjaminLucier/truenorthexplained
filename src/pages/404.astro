---
import BaseLayout from "../layouts/BaseLayout.astro";
import MapleLeaf from "../components/MapleLeaf.astro";
import { t } from "../i18n/en";
---

<BaseLayout title={t.notFound.title}>
  <div class="mx-auto flex max-w-xl flex-col items-center px-4 py-28 text-center">
    <MapleLeaf class="size-16 text-accent" />
    <h1 class="mt-6 text-4xl font-bold tracking-tight text-primary">{t.notFound.title}</h1>
    <p class="mt-3 text-secondary">{t.notFound.text}</p>
    <a href="/" class="mt-8 rounded-full bg-accent px-6 py-3 font-semibold text-accent-contrast hover:bg-accent-hover">
      {t.notFound.back}
    </a>
  </div>
</BaseLayout>
